<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_SC_BP_01"
                  targetNamespace="https://litlfred.github.io/dth-sc/bpmn">

  <bpmn:resource id="pers:ministry-of-health" name="Ministry of health (MOH)"/>
  <bpmn:resource id="pers:steering-committee-sponsor" name="DHSC steering committee, chief digital officer and project sponsor"/>
  <bpmn:resource id="pers:solution-architect" name="Enterprise and solution architect"/>
  <bpmn:resource id="pers:project-manager-ba" name="Project manager, IT manager and business analyst"/>
  <bpmn:resource id="pers:developer-integrator" name="Developer, integration specialist and QA/test team"/>
  <bpmn:resource id="pers:system-administrator-support" name="System administrator, database/infrastructure specialist, support engineer and trainer"/>

  <bpmn:collaboration id="Collab_SC_BP_01">
    <bpmn:participant id="Pool_SC_BP_01" name="SC-BP-01 Stepwise DHSC strategy, architecture and implementation transformation method (SC-BP-01)" processRef="SC_BP_01"/>
  </bpmn:collaboration>

  <bpmn:process id="SC_BP_01" name="Stepwise DHSC strategy, architecture and implementation transformation method (SC-BP-01) (SC-BP-01)" isExecutable="false">
    <bpmn:documentation>Formalizes the handbook&#x27;s stepwise method (Introduction Fig. 4 and Table 1) across Chapter 1 (Defining a holistic DHSC strategy, Steps 1–4), Chapter 2 (Defining the DHSC architecture, Steps 1–3), and Chapter 3 (Planning for scalable implementation and sustainable operations, Steps 1–4), binding each step to the governance and implementation roles defined in Table 1, Annex 2, and Annex 7.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_SC_BP_01">
      <bpmn:lane id="Lane_BP01_MOH" name="Ministry of health (MOH)" partitionElementRef="pers:ministry-of-health">
        <bpmn:flowNodeRef>Start_BP01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP01_01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BP01_Endorsed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP01_SteeringSponsor" name="DHSC steering committee, chief digital officer and project sponsor" partitionElementRef="pers:steering-committee-sponsor">
        <bpmn:flowNodeRef>Task_BP01_02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP01_04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP01_Architect" name="Enterprise and solution architect" partitionElementRef="pers:solution-architect">
        <bpmn:flowNodeRef>Task_BP01_03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP01_06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP01_07</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP01_ProjectManagerBA" name="Project manager, IT manager and business analyst" partitionElementRef="pers:project-manager-ba">
        <bpmn:flowNodeRef>Task_BP01_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP01_08</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP01_DevIntegrator" name="Developer, integration specialist and QA/test team" partitionElementRef="pers:developer-integrator">
        <bpmn:flowNodeRef>Task_BP01_09</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP01_SysAdminSupport" name="System administrator, database/infrastructure specialist, support engineer and trainer" partitionElementRef="pers:system-administrator-support">
        <bpmn:flowNodeRef>Task_BP01_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BP01</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_BP01" name="National DHSC transformation mandate">
      <bpmn:outgoing>Flow_BP01_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_BP01_01" name="Align DHSC mandate with national health and digital health strategies (Fig. 8)">
      <bpmn:incoming>Flow_BP01_01</bpmn:incoming>
      <bpmn:outgoing>Flow_BP01_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP01_02" name="Ch 1 Step 1: Engage stakeholders and form DHSC steering committee &amp; TWGs (Annex 2)">
      <bpmn:incoming>Flow_BP01_02</bpmn:incoming>
      <bpmn:outgoing>Flow_BP01_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP01_03" name="Ch 1 Step 2 &amp; Ch 2 Step 1: Inventory HSCISs (Annex 5) and assess SCISMM maturity (SC-DT-01)">
      <bpmn:incoming>Flow_BP01_03</bpmn:incoming>
      <bpmn:outgoing>Flow_BP01_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP01_04" name="Ch 1 Step 3: Prioritize bottlenecks (Annex 3) and define DHSC vision, goals &amp; outcomes (Annex 4)">
      <bpmn:incoming>Flow_BP01_04</bpmn:incoming>
      <bpmn:outgoing>Flow_BP01_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP01_05" name="Ch 1 Step 4: Define strategic roadmap and key performance indicators (KPIs)">
      <bpmn:incoming>Flow_BP01_05</bpmn:incoming>
      <bpmn:outgoing>Flow_BP01_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP01_06" name="Ch 2 Step 2: Define target DHSC architecture and interoperability framework (Figs. 14–19, SC-DT-01)">
      <bpmn:incoming>Flow_BP01_06</bpmn:incoming>
      <bpmn:outgoing>Flow_BP01_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP01_07" name="Ch 2 Step 3: Map architecture implementation activities to strategic goals (Fig. 21)">
      <bpmn:incoming>Flow_BP01_07</bpmn:incoming>
      <bpmn:outgoing>Flow_BP01_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP01_08" name="Ch 3 Steps 1–3: Charter intervention, operational plan, risk register (Annex 6), staffing (Annex 7) &amp; TCO budget (Table 3)">
      <bpmn:incoming>Flow_BP01_08</bpmn:incoming>
      <bpmn:incoming>Flow_BP01_11</bpmn:incoming>
      <bpmn:outgoing>Flow_BP01_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_BP01_Endorsed" name="Architecture &amp; TCO budget endorsed?">
      <bpmn:incoming>Flow_BP01_09</bpmn:incoming>
      <bpmn:outgoing>Flow_BP01_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_BP01_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_BP01_09" name="Ch 3 Step 4 (Deploy): Configure HSCISs, build interoperability mediators &amp; execute QA/UAT testing">
      <bpmn:incoming>Flow_BP01_10</bpmn:incoming>
      <bpmn:outgoing>Flow_BP01_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP01_10" name="Ch 3 Step 4 (Operate): Provision infrastructure, train users, operate helpdesk &amp; monitor KPIs">
      <bpmn:incoming>Flow_BP01_12</bpmn:incoming>
      <bpmn:outgoing>Flow_BP01_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_BP01" name="DHSC intervention deployed and monitored">
      <bpmn:incoming>Flow_BP01_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_BP01_01" sourceRef="Start_BP01" targetRef="Task_BP01_01"/>
    <bpmn:sequenceFlow id="Flow_BP01_02" sourceRef="Task_BP01_01" targetRef="Task_BP01_02"/>
    <bpmn:sequenceFlow id="Flow_BP01_03" sourceRef="Task_BP01_02" targetRef="Task_BP01_03"/>
    <bpmn:sequenceFlow id="Flow_BP01_04" sourceRef="Task_BP01_03" targetRef="Task_BP01_04"/>
    <bpmn:sequenceFlow id="Flow_BP01_05" sourceRef="Task_BP01_04" targetRef="Task_BP01_05"/>
    <bpmn:sequenceFlow id="Flow_BP01_06" sourceRef="Task_BP01_05" targetRef="Task_BP01_06"/>
    <bpmn:sequenceFlow id="Flow_BP01_07" sourceRef="Task_BP01_06" targetRef="Task_BP01_07"/>
    <bpmn:sequenceFlow id="Flow_BP01_08" sourceRef="Task_BP01_07" targetRef="Task_BP01_08"/>
    <bpmn:sequenceFlow id="Flow_BP01_09" sourceRef="Task_BP01_08" targetRef="Gw_BP01_Endorsed"/>
    <bpmn:sequenceFlow id="Flow_BP01_10" sourceRef="Gw_BP01_Endorsed" targetRef="Task_BP01_09" name="Endorsed"/>
    <bpmn:sequenceFlow id="Flow_BP01_11" sourceRef="Gw_BP01_Endorsed" targetRef="Task_BP01_08" name="Revise scope / budget"/>
    <bpmn:sequenceFlow id="Flow_BP01_12" sourceRef="Task_BP01_09" targetRef="Task_BP01_10"/>
    <bpmn:sequenceFlow id="Flow_BP01_13" sourceRef="Task_BP01_10" targetRef="End_BP01"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_SC_BP_01">
    <bpmndi:BPMNPlane id="BPMNPlane_SC_BP_01" bpmnElement="Collab_SC_BP_01">
      <bpmndi:BPMNShape id="Pool_SC_BP_01_di" bpmnElement="Pool_SC_BP_01" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="2870" height="900"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP01_MOH_di" bpmnElement="Lane_BP01_MOH" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="2840" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP01_SteeringSponsor_di" bpmnElement="Lane_BP01_SteeringSponsor" isHorizontal="true">
        <dc:Bounds x="150" y="230" width="2840" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP01_Architect_di" bpmnElement="Lane_BP01_Architect" isHorizontal="true">
        <dc:Bounds x="150" y="380" width="2840" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BP01_ProjectManagerBA_di" bpmnElement="Lane_BP01_ProjectManagerBA" isHorizontal="true">
        <dc:Bounds x="150" y="530" width="2840" height="150"/>
      </bpmndi:BPMNShape>
