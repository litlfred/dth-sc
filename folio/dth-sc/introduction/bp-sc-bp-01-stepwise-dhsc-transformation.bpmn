        <di:waypoint x="910" y="297.5" />
        <di:waypoint x="925" y="297.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP01_07_di" bpmnElement="Flow_BP01_07">
