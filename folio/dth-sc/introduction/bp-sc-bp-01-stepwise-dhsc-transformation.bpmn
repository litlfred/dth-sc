          <dc:Bounds x="1345" y="815" width="80" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_BP01_01_di" bpmnElement="Flow_BP01_01">
        <di:waypoint x="241" y="587.5" />
        <di:waypoint x="280" y="587.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP01_02_di" bpmnElement="Flow_BP01_02">
        <di:waypoint x="372.5" y="535" />
        <di:waypoint x="372.5" y="205" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP01_03_di" bpmnElement="Flow_BP01_03">
        <di:waypoint x="465" y="152.5" />
