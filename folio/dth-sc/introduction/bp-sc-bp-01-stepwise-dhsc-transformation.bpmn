        <di:waypoint x="1232.5" y="350" />
        <di:waypoint x="1232.5" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP01_09_di" bpmnElement="Flow_BP01_09">
        <di:waypoint x="1232.5" y="495" />
        <di:waypoint x="1232.5" y="562.5" />
      </bpmndi:BPMNEdge>
