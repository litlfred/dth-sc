      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP01_07_di" bpmnElement="Task_BP01_07">
        <dc:Bounds x="1140" y="245" width="185" height="105" />
      </bpmndi:BPMNShape>
