        <dc:Bounds x="1140" y="390" width="185" height="105" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_BP01_Endorsed_di" bpmnElement="Gw_BP01_Endorsed" isMarkerVisible="true">
        <dc:Bounds x="1207.5" y="562.5" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1268" y="575" width="82" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP01_09_di" bpmnElement="Task_BP01_09">
        <dc:Bounds x="1140" y="680" width="185" height="105" />
