        <dc:Bounds x="1557" y="421" width="136" height="68"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BP01_08_di" bpmnElement="Task_BP01_08">
        <dc:Bounds x="1752" y="571" width="136" height="68"/>
