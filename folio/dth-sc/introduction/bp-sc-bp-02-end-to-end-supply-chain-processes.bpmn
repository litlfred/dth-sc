<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_SC_BP_02"
                  targetNamespace="https://litlfred.github.io/dth-sc/bpmn">

  <bpmn:resource id="pers:ministry-of-health" name="Ministry of health (MOH)"/>
  <bpmn:resource id="pers:regulatory-authority" name="National regulatory authority"/>
  <bpmn:resource id="pers:procurer" name="Procurer (national or partner procurement agency)"/>
  <bpmn:resource id="pers:manufacturer-distributor" name="Manufacturer and distributor"/>
  <bpmn:resource id="pers:central-warehouse" name="Central warehouse (central medical store)"/>
  <bpmn:resource id="pers:logistics-provider" name="Logistics provider (transportation and cold chain)"/>
  <bpmn:resource id="pers:regional-district-warehouse" name="Regional and district warehouse (branch warehouse)"/>
  <bpmn:resource id="pers:health-facility" name="Health facility (service delivery point)"/>
  <bpmn:resource id="pers:community-health-worker" name="Community health worker"/>
  <bpmn:resource id="pers:health-service-user" name="Individual (health service user / patient)"/>

  <bpmn:collaboration id="Collab_SC_BP_02">
    <bpmn:participant id="Pool_SC_BP_02" name="SC-BP-02: End-to-end health supply chain core processes and information flow" processRef="SC_BP_02"/>
  </bpmn:collaboration>

  <bpmn:process id="SC_BP_02" name="SC-BP-02: End-to-end health supply chain core processes and information flow" isExecutable="false">
    <bpmn:documentation>Models the nine core health supply chain processes (product selection, forecasting and supply planning, procurement, port/customs clearance, warehousing and inventory management, transportation and cold chain management, requisition and order management, dispensing to patients, and return/recall &amp; consumption feedback) and bidirectional information flow across the ten supply chain partner roles in Introduction Figures 1–3.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_SC_BP_02">
      <bpmn:lane id="Lane_BP02_MOH" name="Ministry of health (MOH)" partitionElementRef="pers:ministry-of-health">
        <bpmn:flowNodeRef>Start_BP02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP02_01</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP02_Regulatory" name="National regulatory authority" partitionElementRef="pers:regulatory-authority">
        <bpmn:flowNodeRef>Task_BP02_02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP02_Procurer" name="Procurer (national or partner procurement agency)" partitionElementRef="pers:procurer">
        <bpmn:flowNodeRef>Task_BP02_03</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP02_Manufacturer" name="Manufacturer and distributor" partitionElementRef="pers:manufacturer-distributor">
        <bpmn:flowNodeRef>Task_BP02_04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP02_CentralWarehouse" name="Central warehouse (central medical store)" partitionElementRef="pers:central-warehouse">
        <bpmn:flowNodeRef>Task_BP02_05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP02_06</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP02_LogisticsProvider" name="Logistics provider (transportation and cold chain)" partitionElementRef="pers:logistics-provider">
        <bpmn:flowNodeRef>Task_BP02_07</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP02_RegionalWarehouse" name="Regional and district warehouse (branch warehouse)" partitionElementRef="pers:regional-district-warehouse">
        <bpmn:flowNodeRef>Task_BP02_08</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP02_HealthFacility" name="Health facility (service delivery point)" partitionElementRef="pers:health-facility">
        <bpmn:flowNodeRef>Task_BP02_09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BP02_Channel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP02_10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP02_CHW" name="Community health worker" partitionElementRef="pers:community-health-worker">
        <bpmn:flowNodeRef>Task_BP02_11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BP02_Individual" name="Individual (health service user / patient)" partitionElementRef="pers:health-service-user">
        <bpmn:flowNodeRef>Task_BP02_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BP02</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_BP02" name="National health supply planning cycle">
      <bpmn:outgoing>Flow_BP02_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_BP02_01" name="1. Product selection &amp; 2. Forecasting and supply planning (Forecasting &amp; Supply Planning System)">
      <bpmn:incoming>Flow_BP02_01</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP02_02" name="Verify marketing authorization and publish product master data in National Product Catalogue (Product Registry)">
      <bpmn:incoming>Flow_BP02_02</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP02_03" name="3. Procurement &amp; supplier/contract management: issue tenders and purchase orders (Procurement &amp; Supplier Systems)">
      <bpmn:incoming>Flow_BP02_03</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP02_04" name="Manufacture, label/serialize products and transmit advance shipping notice (Manufacturer Systems)">
      <bpmn:incoming>Flow_BP02_04</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP02_05" name="4. Port/customs clearance &amp; 5. Warehousing and inventory receipt at central store (WMS / ERP)">
      <bpmn:incoming>Flow_BP02_05</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP02_06" name="7. Requisition &amp; order management: allocate national stock against subnational/facility orders (OMS)">
      <bpmn:incoming>Flow_BP02_06</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP02_07" name="6. Transportation &amp; cold chain management: dispatch and monitor shipment in transit (TMS / Cold Chain System)">
      <bpmn:incoming>Flow_BP02_07</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP02_08" name="Receive consignment, manage branch warehouse inventory &amp; fulfil facility requisitions (WMS / OMS)">
      <bpmn:incoming>Flow_BP02_08</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP02_09" name="Receive stock at service delivery point, manage inventory &amp; submit replenishment orders (HFLMS / OMS)">
      <bpmn:incoming>Flow_BP02_09</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_BP02_Channel" name="Care delivery channel?">
      <bpmn:incoming>Flow_BP02_10</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_BP02_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_BP02_10" name="8. Dispensing at facility and recording consumption &amp; stock-on-hand data (Dispensing System)">
      <bpmn:incoming>Flow_BP02_11</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP02_11" name="8. Last-mile community dispensing &amp; mobile stock/consumption reporting (CHW mobile tool)">
      <bpmn:incoming>Flow_BP02_12</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BP02_12" name="Receive dispensed medicine/vaccine; 9. Report adverse event or return/recall product if alerted">
      <bpmn:incoming>Flow_BP02_13</bpmn:incoming>
      <bpmn:incoming>Flow_BP02_14</bpmn:incoming>
      <bpmn:outgoing>Flow_BP02_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_BP02" name="Consumption and stock data fed back to forecasting">
      <bpmn:incoming>Flow_BP02_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_BP02_01" sourceRef="Start_BP02" targetRef="Task_BP02_01"/>
    <bpmn:sequenceFlow id="Flow_BP02_02" sourceRef="Task_BP02_01" targetRef="Task_BP02_02"/>
    <bpmn:sequenceFlow id="Flow_BP02_03" sourceRef="Task_BP02_02" targetRef="Task_BP02_03"/>
    <bpmn:sequenceFlow id="Flow_BP02_04" sourceRef="Task_BP02_03" targetRef="Task_BP02_04"/>
    <bpmn:sequenceFlow id="Flow_BP02_05" sourceRef="Task_BP02_04" targetRef="Task_BP02_05"/>
    <bpmn:sequenceFlow id="Flow_BP02_06" sourceRef="Task_BP02_05" targetRef="Task_BP02_06"/>
    <bpmn:sequenceFlow id="Flow_BP02_07" sourceRef="Task_BP02_06" targetRef="Task_BP02_07"/>
    <bpmn:sequenceFlow id="Flow_BP02_08" sourceRef="Task_BP02_07" targetRef="Task_BP02_08"/>
    <bpmn:sequenceFlow id="Flow_BP02_09" sourceRef="Task_BP02_08" targetRef="Task_BP02_09"/>
    <bpmn:sequenceFlow id="Flow_BP02_10" sourceRef="Task_BP02_09" targetRef="Gw_BP02_Channel"/>
    <bpmn:sequenceFlow id="Flow_BP02_11" sourceRef="Gw_BP02_Channel" targetRef="Task_BP02_10" name="Facility care"/>
    <bpmn:sequenceFlow id="Flow_BP02_12" sourceRef="Gw_BP02_Channel" targetRef="Task_BP02_11" name="Community care"/>
    <bpmn:sequenceFlow id="Flow_BP02_13" sourceRef="Task_BP02_10" targetRef="Task_BP02_12"/>
    <bpmn:sequenceFlow id="Flow_BP02_14" sourceRef="Task_BP02_11" targetRef="Task_BP02_12"/>
    <bpmn:sequenceFlow id="Flow_BP02_15" sourceRef="Task_BP02_12" targetRef="End_BP02"/>
  </bpmn:process>

