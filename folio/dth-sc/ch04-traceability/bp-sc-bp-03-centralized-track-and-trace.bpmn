      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP03_02_di" bpmnElement="Flow_BP03_02">
        <di:waypoint x="543" y="157" />
        <di:waypoint x="563" y="157" />
        <di:waypoint x="563" y="521.5" />
        <di:waypoint x="583" y="521.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP03_03_di" bpmnElement="Flow_BP03_03">
        <di:waypoint x="759" y="521.5" />
        <di:waypoint x="779" y="521.5" />
        <di:waypoint x="779" y="884" />
        <di:waypoint x="799" y="884" />
      </bpmndi:BPMNEdge>
