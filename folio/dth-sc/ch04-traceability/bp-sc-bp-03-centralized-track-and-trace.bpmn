        <di:waypoint x="995" y="1088.5" />
        <di:waypoint x="1015" y="1088.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP03_05_di" bpmnElement="Flow_BP03_05">
        <di:waypoint x="1191" y="1088.5" />
        <di:waypoint x="1211" y="1088.5" />
        <di:waypoint x="1211" y="1293" />
        <di:waypoint x="1231" y="1293" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP03_06_di" bpmnElement="Flow_BP03_06">
        <di:waypoint x="1407" y="1293" />
