        <di:waypoint x="1971" y="521.5" />
        <di:waypoint x="2012" y="521.5" />
        <di:waypoint x="2012" y="309" />
        <di:waypoint x="2053" y="309" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP03_11_di" bpmnElement="Flow_BP03_11">
        <di:waypoint x="2229" y="734" />
        <di:waypoint x="2273.5" y="734" />
        <di:waypoint x="2273.5" y="521.5" />
        <di:waypoint x="2318" y="521.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP03_12_di" bpmnElement="Flow_BP03_12">
        <di:waypoint x="2229" y="309" />
        <di:waypoint x="2273.5" y="309" />
        <di:waypoint x="2273.5" y="521.5" />
