        <di:waypoint x="1839" y="521.5" />
        <di:waypoint x="1921" y="521.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BP03_09_di" bpmnElement="Flow_BP03_09">
        <di:waypoint x="1971" y="521.5" />
        <di:waypoint x="2012" y="521.5" />
        <di:waypoint x="2012" y="734" />
        <di:waypoint x="2053" y="734" />
      </bpmndi:BPMNEdge>
