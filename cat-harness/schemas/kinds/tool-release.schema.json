      "additionalProperties": false
    },
    "folio-tool-profile/v1": {
      "title": "folio-tool-profile/v1",
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "folio-tool-profile/v1"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*@[^\\s@/]+$"
          }
        }
      },
      "required": [
        "$schema",
        "name",
        "description",
        "tools"
      ],
      "additionalProperties": false
    }
  }
}
