{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litlfred.github.io/cat-harness/v0/schemas/kinds/tool-release.schema.json",
  "_generated": "scripts/gen-kind-json-schemas.ts of cat-harness-tools — do not hand-edit; change the Zod and run `bun run cat kind:json-schemas`",
  "title": "Tool releases",
  "description": "External tool releases -- one `folio-tool-release/v1` document per tool at one version, with its sha256, its source (an OCI image only by digest), its SPDX licence, how to run it, and the runtimes that release needs, injected rather than inherited -- and the named `folio-tool-profile/v1` sets a run selects. A profile never names a runtime.",
  "anyOf": [
    {
      "$ref": "#/$defs/folio-tool-release~1v1"
    },
    {
      "$ref": "#/$defs/folio-tool-profile~1v1"
    }
  ],
  "$defs": {
    "folio-tool-release/v1": {
      "title": "folio-tool-release/v1",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[^\\s@/]+$"
        },
        "digest": {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "verifiedAt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "algorithm",
            "digest"
          ],
          "additionalProperties": false
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "url"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "type",
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "oci"
                },
                "reference": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]*(:[0-9]+)?(\\/[a-z0-9._-]+)+@sha256:([0-9a-f]{64})$"
                }
              },
              "required": [
                "type",
                "reference"
              ],
              "additionalProperties": false
            }
          ]
        },
        "licence": {
          "type": "string",
          "minLength": 1
        },
        "licenceSource": {
          "type": "string",
          "minLength": 1
        },
        "$schema": {
          "type": "string",
          "const": "folio-tool-release/v1"
        },
        "role": {
          "type": "string",
          "enum": [
            "tool",
            "runtime"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "jar",
            "archive",
            "binary",
            "oci-image",
            "toolchain-file"
          ]
        },
        "platform": {
          "type": "object",
          "properties": {
            "os": {
              "type": "string",
              "enum": [
                "linux",
                "darwin",
                "windows"
              ]
            },
            "arch": {
              "type": "string",
              "enum": [
                "x64",
                "arm64"
              ]
            },
            "distribution": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]*$"
            }
          },
          "required": [
            "os",
            "arch"
          ],
          "additionalProperties": false
        },
        "runtimes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "release": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*@[^\\s@/]+$"
              },
              "inject": {
                "type": "string",
                "enum": [
                  "JAVA_HOME",
                  "PATH"
                ]
              }
            },
            "required": [
              "release",
              "inject"
            ],
            "additionalProperties": false
          }
        },
        "entry": {
          "type": "object",
          "properties": {
            "template": {
              "type": "string",
              "minLength": 1
            },
            "home": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "template"
          ],
          "additionalProperties": false
        },
        "note": {
          "type": "string",
          "minLength": 1
