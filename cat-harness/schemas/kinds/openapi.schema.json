{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litlfred.github.io/cat-harness/v0/schemas/kinds/openapi.schema.json",
  "_generated": "scripts/gen-kind-json-schemas.ts of cat-harness-tools — do not hand-edit; change the Zod and run `bun run cat kind:json-schemas`",
  "title": "Openapi",
  "description": "OpenAPI 3 documents an instance holds, each verbatim beside a provenance node naming the repository, path and commit it was ingested from (cat-harness's `openapi` subgraph). Every operation in a document is a node of its own: a page and an IRI under the instance's docs.",
  "anyOf": [
    {
      "$ref": "#/$defs/folio-openapi-source~1v1"
    },
    {
      "$ref": "#/$defs/cat-openapi-config~1v1"
    }
  ],
  "$defs": {
    "folio-openapi-source/v1": {
      "title": "folio-openapi-source/v1",
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "folio-openapi-source/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.openapi\\.json$"
        },
        "source": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[\\w.-]+\\/[\\w.-]+$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "default": "main",
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "repository",
            "path",
            "commit"
          ],
          "additionalProperties": false
        },
        "bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "openapi": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "materialization": {
          "type": "object",
          "properties": {
            "$schema": {
              "type": "string",
              "const": "folio-materialization/v1"
            },
            "state": {
              "type": "string",
              "const": "materialized"
            },
            "localPath": {
              "type": "string",
              "minLength": 1
            },
            "purpose": {
              "type": "string",
              "const": "working"
            },
            "fixity": {
              "type": "object",
              "properties": {
                "algorithm": {
                  "type": "string",
                  "const": "sha256"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "algorithm",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "$schema",
            "state",
            "localPath",
            "purpose",
            "fixity"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "$schema",
        "id",
        "file",
        "source",
        "bytes",
        "openapi",
        "title",
        "version",
        "operations",
        "materialization"
      ],
      "additionalProperties": false
    },
    "cat-openapi-config/v1": {
      "title": "cat-openapi-config/v1",
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "cat-openapi-config/v1"
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "documents": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "properties": {
                  "repository": {
                    "type": "string",
                    "pattern": "^[\\w.-]+\\/[\\w.-]+$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ref": {
                    "default": "main",
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "repository",
                  "path"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "rendered": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "rendered": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "url"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "rendered"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "$schema",
        "directory"
      ],
      "additionalProperties": false
    }
  }
}
