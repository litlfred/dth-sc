{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litlfred.github.io/cat-harness/v0/schemas/kinds/health.schema.json",
  "_generated": "scripts/gen-kind-json-schemas.ts of cat-harness-tools — do not hand-edit; change the Zod and run `bun run cat kind:json-schemas`",
  "title": "Health",
  "description": "Repository health reports — one `health-report/v1` document per sweep, carrying every check's three-state verdict, the thresholds it applied and the basis each threshold was chosen on. Generated by `test/health/run.ts`; never hand-edited.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "health-report/v1"
    },
    "producer": {
      "type": "object",
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "script_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "script",
        "script_hash"
      ]
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "repository"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "clean",
        "findings",
        "unknown"
      ]
    },
    "checks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "ok",
              "finding",
              "unknown"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "thresholds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "metric": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "critical",
                    "major",
                    "minor"
                  ]
                }
              },
              "required": [
                "metric",
                "value",
                "unit",
                "basis",
                "severity"
              ]
            }
          },
          "measurements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "metric": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "metric",
                "value",
                "unit",
                "command"
              ]
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "metric": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "critical",
                    "major",
                    "minor"
                  ]
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "summary",
                "severity",
                "action"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "state",
          "summary",
          "thresholds",
          "measurements",
          "findings"
        ]
      }
    },
    "runContext": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "producer",
    "subject",
    "updated_at",
    "verdict",
    "checks"
  ]
}
