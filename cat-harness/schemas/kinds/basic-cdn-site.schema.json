              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "mtime": {
                "type": "string"
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mimetype_sniffed": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mimetype_source": {
                "type": "string",
                "enum": [
                  "magic-bytes",
                  "unrecognised",
                  "unreadable"
                ]
              }
            },
            "required": [
              "path",
              "kind"
            ]
