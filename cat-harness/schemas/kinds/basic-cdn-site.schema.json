      "title": "basic-cdn-site/1.0.0",
      "type": "object",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        },
        "routes": {
          "type": "object",
          "properties": {
            "release": {
              "type": "string",
              "pattern": "^(?!\\/)[^\\s]*$"
            },
            "previews": {
              "type": "string",
              "pattern": "^(?!\\/)[^\\s]*$"
            },
            "subSites": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!\\/)[^\\s]*$"
                  },
                  "instance": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "instance"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "release"
          ],
          "additionalProperties": false
        },
        "builtFrom": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            }
          },
          "required": [
            "ref",
            "sha"
          ],
          "additionalProperties": false
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
