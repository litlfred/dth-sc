{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litlfred.github.io/cat-harness/v0/schemas/kinds/block-kinds.schema.json",
  "_generated": "scripts/gen-kind-json-schemas.ts of cat-harness-tools — do not hand-edit; change the Zod and run `bun run cat kind:json-schemas`",
  "title": "Block kinds",
  "description": "The block kinds a harness's adapter owns, one node per kind carrying its label prefix, RDF types, profile and builder. Discovered across the instances; no module lists them.",
  "anyOf": [
    {
      "$ref": "#/$defs/folio-block-kind~1v1"
    }
  ],
  "$defs": {
    "folio-block-kind/v1": {
      "title": "folio-block-kind/v1",
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "const": "folio-block-kind/v1"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "enum": [
            "document",
            "paper"
          ]
        },
        "builder": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "labelPrefix": {
          "type": "string",
          "pattern": "^[a-z]+$"
        },
        "prefixEnforced": {
          "default": true,
          "type": "boolean"
        },
        "provable": {
          "default": false,
          "type": "boolean"
        },
        "folioType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:[A-Z][A-Za-z]*$"
        },
        "docoType": {
          "type": "string",
          "pattern": "^doco:[A-Z][A-Za-z]*$"
        },
        "heading": {
          "type": "string"
        },
        "headingPlural": {
          "type": "string",
          "minLength": 1
        },
        "indexRank": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "$schema",
        "kind",
        "adapter",
        "labelPrefix",
        "folioType"
      ],
      "additionalProperties": false
    }
  }
}
