{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litlfred.github.io/cat-harness/v0/schemas/kinds/qa-report.schema.json",
  "_generated": "scripts/gen-kind-json-schemas.ts of cat-harness-tools — do not hand-edit; change the Zod and run `bun run cat kind:json-schemas`",
  "title": "QA reports",
  "description": "QA reports -- one `qa-report/v1` document per tool run, carrying the tool's own successes, warnings and errors, the files it processed, the files it EXPECTED and the ones that were missing, plus the provenance and toolchain versions upstream records nowhere. Generated by the run; never hand-edited.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "qa-report/v1"
    },
    "producer": {
      "type": "string",
      "enum": [
        "dak-script",
        "ig-publisher"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "runUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "tool"
      ]
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "publisher": {
          "type": "string"
        },
        "sushi": {
          "type": "string"
        },
        "fhirVersion": {
          "type": "string"
        }
      }
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed"
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_successes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_warnings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_errors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "files_processed_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "files_expected_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "files_missing_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completion_timestamp": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "total_successes",
        "total_warnings",
        "total_errors",
        "files_processed_count",
        "files_expected_count",
        "files_missing_count"
      ]
    },
    "details": {
      "type": "object",
      "properties": {
        "successes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1
              },
              "timestamp": {
                "type": "string",
                "minLength": 1
              },
              "details": {}
            },
            "required": [
              "message",
              "timestamp"
            ]
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1
              },
              "timestamp": {
                "type": "string",
                "minLength": 1
              },
              "details": {}
            },
            "required": [
              "message",
              "timestamp"
            ]
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1
              },
              "timestamp": {
                "type": "string",
                "minLength": 1
              },
              "details": {}
            },
            "required": [
              "message",
              "timestamp"
            ]
          }
        },
        "files_processed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "timestamp": {
                "type": "string",
                "minLength": 1
              },
              "details": {}
            },
            "required": [
              "file",
              "status",
              "timestamp"
            ]
          }
        },
        "files_expected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files_missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "successes",
        "warnings",
        "errors",
        "files_processed",
        "files_expected",
        "files_missing"
      ]
    },
    "runContext": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "producer",
    "source",
    "phase",
    "timestamp",
    "status",
    "summary",
    "details"
  ]
}
