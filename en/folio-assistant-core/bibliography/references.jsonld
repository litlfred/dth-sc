    {
      "@id": "references/10665-259268",
      "@type": [
        "fabio:Work",
        "bibo:Report"
      ],
      "dcterms:title": "WHO recommendations on maternal health: guidelines approved by the WHO Guidelines Review Committee",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2017-10-17",
      "dcterms:publisher": "World Health Organization",
      "dcterms:identifier": "https://iris.who.int/handle/10665/259268",
      "dcterms:language": "en",
      "dcterms:abstract": "This publication compiles WHO recommendations on maternal health that have been approved by the WHO Guidelines Review Committee into a single, accessible reference for WHO staff, policy-makers, programme managers and health professionals. It brings together current WHO guidance covering the continuum of maternal care during pregnancy, childbirth and the postnatal period, with the dual purpose of facilitating access to recommendations and helping identify areas where further guideline updates are needed. The document indicates newly issued and updated recommendations since 2013 and provides, for each recommendation, its strength, the quality of supporting evidence and the corresponding source guideline.\n\nThe compilation addresses interventions to promote, prevent and protect maternal and perinatal health, including antenatal care, prevention and management of pre-eclampsia, preterm birth, peripartum infections, labour and childbirth, postpartum haemorrhage, postnatal care and health promotion, as well as the management of maternal conditions such as HIV infection, malaria and tuberculosis. Developed according to WHO’s guideline development process using the GRADE approach and structured evidence-to-decision frameworks, it presents evidence-informed recommendations intended to support consistent policy development, clinical practice and programme implementation across diverse health-care settings.",
      "dcterms:source": "who-iris/catalogue/records/10665-259268.dc.json"
    },
    {
      "@id": "references/10665-255866",
