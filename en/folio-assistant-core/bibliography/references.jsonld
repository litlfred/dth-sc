    {
      "@id": "references/10665-77764",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "WHO recommendations: optimizing health worker roles to improve access to key maternal and newborn health interventions through task shifting",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2012-12-19",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789241504843",
      "dcterms:identifier": "https://iris.who.int/handle/10665/77764",
      "dcterms:language": "en",
      "dcterms:abstract": "This WHO guidance provides evidence-based recommendations on optimizing health worker roles through task shifting to improve universal access to key maternal and newborn health interventions. Developed in response to health workforce shortages and inequities in access to care, it assesses whether specific interventions can be delivered safely and effectively by different health worker cadres, including lay health workers, auxiliary nurses and nurse midwives, nurses, midwives, associate clinicians, advanced level associate clinicians and non-specialist doctors.\n\nThe guidance presents 119 recommendations, ranging from practices recommended for implementation to those requiring targeted monitoring and evaluation, rigorous research, or not recommended. It emphasizes that task shifting should complement efforts to increase skilled care and should aim to expand access while maintaining safety. Implementation should consider health-system capacity and local sociocultural, political and financial conditions, with recommendations adapted through national dialogue and considered as packages of interventions rather than in isolation.",
      "dcterms:source": "who-iris/catalogue/records/10665-77764.dc.json"
    },
