    {
      "@id": "references/10665-94830",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "WHO guidelines for screening and treatment of precancerous lesions for cervical cancer prevention",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2013-11-19",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789241548694",
      "dcterms:identifier": "https://iris.who.int/handle/10665/94830",
      "dcterms:language": "en",
      "dcterms:abstract": "These guidelines provide recommendations for screen-and-treat strategies to prevent cervical cancer by detecting and treating precancerous cervical lesions. The screen-and-treat approach bases treatment decisions on screening results, allowing treatment soon or ideally immediately after a positive test, rather than requiring histological confirmation. The guidelines compare strategies using human papillomavirus (HPV) testing, visual inspection with acetic acid (VIA), and cytology, linked to treatment with cryotherapy or loop electrosurgical excision procedure (LEEP). They are intended primarily to support policy-makers, programme managers and other health professionals in selecting appropriate cervical cancer prevention strategies according to available resources and existing programmes.\n\nNine recommendations are provided. HPV-based screening is generally preferred where feasible, while VIA is suggested where HPV testing is not feasible; cold knife conization is not recommended as part of a screen-and-treat strategy. Recommendations apply to all women, with specific guidance for women living with HIV. Decision-making and implementation flowcharts support adaptation of the recommended strategies to country and regional contexts.",
      "dcterms:source": "who-iris/catalogue/records/10665-94830.dc.json"
    },
    {
      "@id": "references/WER8925_265-287",
      "@type": [
