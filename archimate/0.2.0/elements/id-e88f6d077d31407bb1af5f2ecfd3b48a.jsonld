  "schema:identifier": "id-e88f6d077d31407bb1af5f2ecfd3b48a",
  "schema:name": "Traceability",
  "schema:description": "The ability to track a product’s journey from origin to end-user – is crucial for non-profit and Public Health work. Whether distributing medicines, food aid, or other essential goods, organizations need end-to-end visibility to ensure products are authentic, safely handled, and actually reach intended beneficiaries. By assigning unique identifiers to products and capturing their movements in a digital system, stakeholders can quickly pinpoint where an item is at any given time or isolate issues (like a bad batch of medication) and initiate targeted recalls[1]. In low-resource settings, improving traceability boosts trust and reduces fraud, theft, and counterfeiting – common problems that undermine humanitarian efforts[2][3]. Overall, robust traceability systems enhance transparency and accountability, which are core values in Public Health supply chains.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0.jsonld"
}
