  "@type": "archimate:Goal",
  "schema:identifier": "id-4a454b403ed94cbfb5aa957004b2a45c",
  "schema:name": "Goal (MS)",
  "schema:description": "A high-level statement of intent, direction, or desired state for an organization and its stakeholders. \n\nGoals are expressed qualitatively, and can represent anything a stakeholder may desire, such as a state of affairs, or a produced value.  Goals define direction and intention, and may be broken into smaller sub-goals or linked to measurable outcomes. \n\nGoals are typically used to measure success of an organization and it is common to associate concrete outcomes with goals. \n\n\n\nExamples:\n\n* Universal access to personal health records\n\n* Optimize Supply Chain Management\n\n* Enhance Climate Resilience with Predictive Capabilities",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0.jsonld"
}
