    {
      "id": "id-e162b2223da4440983514be5854b654d",
      "name": "CDE-HWR: Core Data Elements for the Health Workforce Registry",
      "type": "DataObject",
      "documentation": "CDE-HWR: the Core Data Elements of the Health Workforce Registry. The deliberately minimal record the HWR holds as the system of record for each health worker:\n1. Named demographics (name, sex, date of birth).\n2. Identifier and index: the national unique health worker identifier, with cross-references to foundational ID where the law allows.\n3. Licensure: licence number, issuing body, status, validity dates.\n4. Registration: professional registration and cadre (ISCO-08 based health worker classification).\n5. Educational credential: qualification, awarding institution, year.\n6. Organizational affiliation: employer or other affiliating organization.\n7. Facility association: the facility or facilities where the worker practises, by Facility Registry identifier.\nAnything else (employment transactions, payroll, training history, etc.) stays in the operational system that owns it.",
      "attributes": [
        {
          "name": "Named demographics",
          "description": "name, sex, date of birth",
          "source": "documentation"
        },
        {
          "name": "Identifier and index",
          "description": "the national unique health worker identifier, with cross-references to foundational ID where the law allows",
          "source": "documentation"
        },
        {
          "name": "Licensure",
          "description": "licence number, issuing body, status, validity dates",
          "source": "documentation"
        },
        {
          "name": "Registration",
          "description": "professional registration and cadre (ISCO-08 based health worker classification)",
          "source": "documentation"
        },
        {
          "name": "Educational credential",
          "description": "qualification, awarding institution, year",
          "source": "documentation"
        },
        {
          "name": "Organizational affiliation",
          "description": "employer or other affiliating organization",
          "source": "documentation"
        },
        {
          "name": "Facility association",
          "description": "the facility or facilities where the worker practises, by Facility Registry identifier",
          "source": "documentation"
        }
      ],
