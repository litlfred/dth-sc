  "@id": "https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1/elements/id-c44b3bdd9ad54f52b96fa91a26e43ffa.jsonld",
  "@type": "archimate:Capability",
  "schema:identifier": "id-c44b3bdd9ad54f52b96fa91a26e43ffa",
  "schema:name": "Capability",
  "schema:description": "A high-level ability that an organization, system, or individual possesses or must develop in order to achieve its strategic goals. It expresses what the enterprise is able to do, independent of how that ability is implemented.\n\n\n\nA capability is usually named using a phrase that emphasizes “what we do”. It represents an outcome-oriented, strategic abstraction of the enterprise’s abilities. \n\nExamples: \n- Patient Registration & Intake\r\n- Medication Prescribing & Dispensing\n- Clinical Decision Support",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.3.0-draft.1.jsonld"
}
