  "@type": "archimate:Outcome",
  "schema:identifier": "id-507c1fec69364428be1403deb271eb12",
  "schema:name": "Improved enrolment processes with measurable time reduction. ",
  "schema:description": "This outcome involves the streamlining of the registration journey for new members into health insurance or coverage schemes. It focuses on achieving a measurable reduction in the time required to complete the enrollment lifecycle.\r\n\r\nThe goal is to lower the barriers to entry for citizens, encouraging higher participation in health protection programs. Faster enrollment ensures that individuals can access benefits almost immediately after becoming eligible.\r\n\r\nExample: A mobile enrollment app that reduces \r\nthe time to register a new member from several days to under ten minutes.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
