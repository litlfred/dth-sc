  "schema:identifier": "id-e259f944473c44e5babd6bf90b7c7ee0",
  "schema:name": "Health Worker Digital Credential/ CV",
  "schema:description": "The secure, tamper-proof digital portfolio that aggregates an individual health worker’s verified professional identity, active licenses, educational history, and specialized clinical competencies. This decentralized, machine-readable record utilizes secure cryptographic signatures issued directly by authoritative licensing boards and universities, allowing the clinician to store, manage, and share their official credentials seamlessly across employers and digital platforms.\r\n\r\nPossessing this digital credential eliminates the tedious paperwork, manual verification delays, and high administrative costs typically associated with background checks and hospital credentialing cycles. For healthcare professionals, it serves as a portable, instantly verifiable CV that accelerates onboarding, simplifies cross-regional licensing, and empowers them to prove their legal scope of practice with a single digital click.\r\n\r\nExample: \"The rollout of the Health Worker Digital Credential, which allowed a traveling physician to instantly share her cryptographically signed board certifications with a rural clinic, enabling her to begin treating patients within hours instead of weeks.\"",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
