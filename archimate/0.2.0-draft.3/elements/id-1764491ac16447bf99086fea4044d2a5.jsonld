  "@type": "archimate:Capability",
  "schema:identifier": "id-1764491ac16447bf99086fea4044d2a5",
  "schema:name": "Care Team Communication Management",
  "schema:description": "This capability provides structured, secure communication services that enable care team members to exchange information, coordinate tasks, and collaborate across clinical and operational workflows.\r\n\r\nThe purpose of this capability is to ensure that all members of a care team share a common, timely understanding of a patient's status and care responsibilities. It also improves accountability, reduces communication-related errors, and supports coordinated action across disciplines and facilities.\r\n\r\nExample: A multidisciplinary team managing a post-surgical patient uses a shared communication platform to exchange updates, assign monitoring tasks, and escalate concerns. All interactions are linked to the patient's record and traceable by the care team and facility administrators.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
