  "@type": "archimate:Goal",
  "schema:identifier": "id-e424d45924894af2a3088cf7c503a684",
  "schema:name": "Protection mechanisms for health system users",
  "schema:description": "This subgoal focuses on establishing digital enrollment and eligibility systems to safeguard citizens from catastrophic health expenditures. It incorporates data protection and dispute resolution mechanisms to ensure that user rights and benefits are protected.\r\n\r\nThe purpose is to provide financial security and privacy while ensuring that vulnerable populations are correctly targeted for coverage. It enables real-time entitlement checks at the point of care to reduce out-of-pocket costs and liability.\r\n\r\nExample: A patient’s insurance eligibility being verified instantly at a clinic, ensuring they only pay their designated co-pay.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
