  "schema:identifier": "id-5df325ab5f9845a8bb16051b78c36d67",
  "schema:name": "Authentication and authorisation",
  "schema:description": "This service manages the digital identities of all users and verifies their specific permissions before granting access to health financing applications. It ensures that only authorized personnel can perform sensitive financial actions like budget approval.\r\n\r\nThe intent is to provide the primary security defense for the national health financing infrastructure. It protects the integrity of the health budget by strictly controlling who can view, enter, or approve financial data.\r\n\r\nExample: A login service that verifies a user's role as a \"Finance Manager\" before allowing them to authorize a payment schedule.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
