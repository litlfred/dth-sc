  "schema:identifier": "id-adfdce3f347d488ea1e1092a1ec218ec",
  "schema:name": "Guideline adherence rates, patient outcome improvements, cost-effectiveness",
  "schema:description": "These indicators measure the effectiveness of clinical decision support implementation and guideline adoption across healthcare settings. They assess improvements in care quality, patient outcomes, and operational efficiency.\r\n\r\nThe purpose of these metrics is to support performance monitoring and continuous quality improvement initiatives within healthcare systems. They also demonstrate the value and impact of evidence-based clinical interventions.\r\n\r\nExample: A health department tracks reductions in hospital readmission rates after implementing standardized treatment protocols.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
