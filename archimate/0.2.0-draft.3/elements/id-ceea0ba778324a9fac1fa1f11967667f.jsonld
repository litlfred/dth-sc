  "@type": "archimate:Capability",
  "schema:identifier": "id-ceea0ba778324a9fac1fa1f11967667f",
  "schema:name": "Financial performance monitoring & disclosure (ability to monitor execution and publish accountable views)",
  "schema:description": "An essential transparency and oversight capability achieved by continuously evaluating health spending variations against targeted performance benchmarks and subsequently publishing these evaluations for public and administrative scrutiny. This comprehensive framework aggregates real-time transaction data into clear, standardized performance metrics that measure not just how much money was spent, but what health outcomes were actually delivered.\r\n\r\nIts primary purpose is to institutionalize financial accountability and combat waste by keeping the entire execution lifecycle visible to both oversight bodies and civil society. By standardizing the proactive disclosure of financial performance, it deters corruption, fosters public trust, and gives internal auditors the precise data needed to correct inefficiencies before they escalate.\r\n\r\nExample: A provincial health department uses its oversight portal to track a multi-million dollar hospital expansion project, matching monthly spending data against construction milestones and automatically publishing a public scorecard that confirms the facility was completed on schedule and within 2% of its original budget.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
