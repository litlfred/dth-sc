  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3/elements/id-8481f5d95240477e9fb462fdab759878.jsonld",
  "@type": "archimate:ApplicationService",
  "schema:identifier": "id-8481f5d95240477e9fb462fdab759878",
  "schema:name": "Profile Management Service",
  "schema:description": "The self-contained software component within the enterprise application layer that manages the creation, storage, and secure retrieval of individual health worker profiles, demographic details, and employment histories.\r\n\r\nThe purpose of this service is to provide a single, standardized interface for applications to securely view or update personal and professional practitioner data while maintaining strict access controls and record history tracking.\r\n\r\nExample: \"The Profile Management Service allowed an administrative assistant to instantly update a physician's primary clinic address and contact information across the entire regional hospital network.\"",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
