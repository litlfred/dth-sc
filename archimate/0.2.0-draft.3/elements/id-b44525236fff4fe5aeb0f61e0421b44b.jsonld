  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3/elements/id-b44525236fff4fe5aeb0f61e0421b44b.jsonld",
  "@type": "archimate:Outcome",
  "schema:identifier": "id-b44525236fff4fe5aeb0f61e0421b44b",
  "schema:name": "Faster decision-making and response during acute events or transitions.",
  "schema:description": "This outcome enables care teams to rapidly exchange critical information, escalate concerns, and coordinate responses during time-sensitive clinical situations.\r\n\r\nThe purpose of this outcome is to reduce the time between recognizing a clinical problem and taking action, which is especially critical during acute events where delays can directly worsen patient outcomes. It also supports smoother transitions by ensuring receiving teams are fully briefed before care is handed over.\r\n\r\nExample: When a patient in a community health facility shows signs of sepsis, the attending nurse uses the platform to simultaneously alert the on-call physician, request an ambulance, and share the patient's vitals and history with the receiving hospital. All of this happens within minutes.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
