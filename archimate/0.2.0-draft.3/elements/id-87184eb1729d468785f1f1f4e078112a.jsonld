  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3/elements/id-87184eb1729d468785f1f1f4e078112a.jsonld",
  "@type": "archimate:Goal",
  "schema:identifier": "id-87184eb1729d468785f1f1f4e078112a",
  "schema:name": "Informed financial planning",
  "schema:description": "This subgoal involves using digital business intelligence and financial modeling to guide health sector resource management. It integrates diverse data sources to provide a unified view of health finance and expenditure trends.\r\n\r\nThe purpose is to enable accurate and timely forecasting to prevent funding gaps and budget overruns. It ensures that government officials and facility managers have the evidence needed for effective spend planning.\r\n\r\nExample: A ministry using rolling budget forecasts to predict the financial requirements of a national health program.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
