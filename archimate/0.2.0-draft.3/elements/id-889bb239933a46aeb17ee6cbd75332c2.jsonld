  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3/elements/id-889bb239933a46aeb17ee6cbd75332c2.jsonld",
  "@type": "archimate:Goal",
  "schema:identifier": "id-889bb239933a46aeb17ee6cbd75332c2",
  "schema:name": "Transparency & Accountability",
  "schema:description": "This subgoal establishes an auditable and traceable financial environment through non-repudiable transactions and compliance monitoring. It utilizes standardized governance guidelines to ensure that all fund expenditures are documented and accessible for review.\r\n\r\nThe purpose is to build systemic trust and ensure that health funds are used for their intended clinical purposes. It provides a permanent audit trail and public disclosure tools that allow civil society and regulators to oversee financial integrity.\r\n\r\nExample: A public transparency dashboard that allows citizens to view the execution and auditing of the national health budget.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
