  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3/elements/id-56d4bc8ab1574865a10de2c0d8ba8947.jsonld",
  "@type": "archimate:ApplicationService",
  "schema:identifier": "id-56d4bc8ab1574865a10de2c0d8ba8947",
  "schema:name": "Terminology Service",
  "schema:description": "The self-contained software component within the enterprise application layer that manages, maps, and distributes standardized medical vocabularies, clinical coding systems, and health worker competency taxonomies.\r\n\r\nThe purpose of this service is to ensure that disparate digital systems can accurately translate and understand clinical data and professional classifications by resolving semantic differences through a single, authoritative reference point.\r\n\r\nExample: \"The Terminology Service automatically translated a legacy regional hospital's internal staffing codes into the standardized national health worker catalog format during a system-wide database upgrade.\"",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
