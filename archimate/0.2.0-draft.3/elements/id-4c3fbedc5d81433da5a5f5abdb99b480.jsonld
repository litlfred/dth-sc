  "schema:identifier": "id-4c3fbedc5d81433da5a5f5abdb99b480",
  "schema:name": "Task-Specific Guidance Service",
  "schema:description": "This application service delivers context-aware instructions, recommendations, and procedural guidance for specific clinical activities and workflows. It provides targeted support based on the task being performed and the user’s role.\r\n\r\nThe purpose of this application service improves consistency, accuracy, and compliance in the execution of clinical and operational tasks. It also reduces variability in healthcare procedures and workflows.\r\n\r\nExample: A nurse receives step-by-step vaccination guidance and dosage recommendations during immunization administration.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
