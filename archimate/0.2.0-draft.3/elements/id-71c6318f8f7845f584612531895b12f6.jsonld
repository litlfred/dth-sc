  "schema:identifier": "id-71c6318f8f7845f584612531895b12f6",
  "schema:name": "Public Health Authorities",
  "schema:description": "Public health authorities are agencies tasked with population-level health monitoring, disease surveillance, and emergency response planning. They use aggregated health data to track trends and inform policy decisions.\r\n\r\nThe purpose is to gain access to aggregated, reliable data for effective planning, surveillance, and epidemic response. This leads to better resource allocation and improved population health outcomes through data-driven strategies.\r\n\r\nExample: An epidemiology center using real-time anonymized PHR data to track the spread of a seasonal flu outbreak.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
