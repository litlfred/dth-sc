  "@type": "archimate:Capability",
  "schema:identifier": "id-50ad23c10dab416689d1f30c9cd56cd3",
  "schema:name": "Unified Health Accounts (ability to compile and report standardized national health accounts)",
  "schema:description": "A comprehensive financial aggregation capability achieved by systematically consolidating all public, private, and donor health expenditures into a single, standardized national accounting framework. This unified system maps diverse cash flows using internationally recognized classifications, ensuring that every dollar spent on health is captured, categorized, and tracked consistently regardless of its origin.\r\n\r\nIts primary purpose is to provide policymakers with a complete, bird's-eye view of total health spending to guide strategic investments and resource allocation. By breaking down spending by disease, service type, and population group, it enables governments to evaluate equity, identify structural inefficiencies, and benchmark their health financing against global standards.\r\n\r\nExample: Using a unified health accounts platform, a country’s ministry of health aggregates data from social insurance, external international donors, and private out-of-pocket spending to discover that 40% of all health resources are being consumed by specialized curative care, prompting a national policy shift toward funding primary preventive health clinics instead.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
