  "schema:identifier": "id-55d328f5fee2417fb7f2d89cc2073142",
  "schema:name": "Health Record Management Service",
  "schema:description": "This service provides the core functionality for creating, updating, and querying longitudinal patient records. It supports the PHR apps, clinical portals, and third-party APIs that interact with health data.\r\n\r\nThe purpose is to provide a standardized way to manage clinical data throughout its lifecycle. It ensures that health information is stored in a structured format that supports both care and analytics.\r\n\r\nExample: A FHIR-based service that allows a mobile app to retrieve a list of a patient’s active medications.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
