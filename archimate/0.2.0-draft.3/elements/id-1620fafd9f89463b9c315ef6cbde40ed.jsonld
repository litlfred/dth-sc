  "@type": "archimate:Goal",
  "schema:identifier": "id-1620fafd9f89463b9c315ef6cbde40ed",
  "schema:name": "Pooling of funds: Manage pooled funds at scheme level for financial protection, coverage continuity, efficient resource use.",
  "schema:description": "Pooling of funds is the management of collected health revenues at a scheme level to spread financial risks across the entire population. It minimizes the impact of high-cost medical events on any single individual by aggregating resources into a collective fund.\r\n\r\nIts purpose is to provide financial protection and ensure coverage continuity regardless of a person's individual health status or wealth. This mechanism promotes efficient resource use and maintains the stability of the health financing ecosystem through risk-sharing.\r\n\r\nExample: A national social health insurance fund that aggregates premiums from healthy workers to cover the medical costs of the elderly and chronically ill.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
