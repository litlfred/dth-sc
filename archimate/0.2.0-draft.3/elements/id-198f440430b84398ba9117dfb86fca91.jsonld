  "@type": "archimate:Outcome",
  "schema:identifier": "id-198f440430b84398ba9117dfb86fca91",
  "schema:name": "Standardized, evidence-based guidance library embedded across facilities and digital systems",
  "schema:description": "This outcome provides a centralized repository of validated clinical protocols and treatment guidelines. It ensures that healthcare facilities and digital systems access the same updated clinical recommendations.\r\n\r\nThe purpose of this outcome is to promote consistent healthcare delivery and minimize discrepancies in medical practices across providers and institutions. It also ensures that clinicians rely on current and approved medical guidance.\r\n\r\nExample: National hypertension management guidelines are integrated into all government hospital electronic medical record systems.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
