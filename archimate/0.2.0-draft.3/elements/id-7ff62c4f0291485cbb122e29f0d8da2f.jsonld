  "schema:identifier": "id-7ff62c4f0291485cbb122e29f0d8da2f",
  "schema:name": "Strategic Purchasing & Provider Payment",
  "schema:description": "This value stream manages the active procurement of healthcare services from providers using evidence-based contracts and standardized payment models. It transitions health financing from passive budget transfers to result-oriented reimbursement cycles.\r\n\r\nThe goal is to maximize the value of health spending by incentivizing high-quality care and improving clinical efficiency. It ensures that healthcare providers are paid fairly and promptly according to established performance metrics and tariffs.\r\n\r\nExample: A social health fund reimbursing hospitals based on \"cost-per-case\" bundles rather than fixed annual grants.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
