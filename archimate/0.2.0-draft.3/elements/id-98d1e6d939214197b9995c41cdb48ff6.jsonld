  "@type": "archimate:Stakeholder",
  "schema:identifier": "id-98d1e6d939214197b9995c41cdb48ff6",
  "schema:name": "Facility Managers",
  "schema:description": "These are the administrative leaders of hospitals, clinics, and health centers who manage the budgets and operational costs of their organizations. They rely on steady funding streams to maintain services and staff.\r\n\r\nThe purpose is to achieve better spend planning and resource allocation within their facilities. They value the predictability of funding and the ability to track their financial performance against their service goals.\r\n\r\nExample: A hospital CEO using a finance dashboard to see which departments are over-budget due to rising medication costs.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
