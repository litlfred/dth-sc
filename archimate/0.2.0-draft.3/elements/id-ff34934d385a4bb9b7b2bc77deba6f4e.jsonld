  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3/elements/id-ff34934d385a4bb9b7b2bc77deba6f4e.jsonld",
  "@type": "archimate:Outcome",
  "schema:identifier": "id-ff34934d385a4bb9b7b2bc77deba6f4e",
  "schema:name": "Continuous feedback loops into care quality (patient-reported data integrated into clinical record).",
  "schema:description": "This outcome ensures that information reported by patients about their symptoms, experiences, and well-being is systematically collected, integrated into their clinical record, and used to inform care decisions and quality improvement processes. \r\n\r\nThe purpose of this outcome is to ensure that the patient's perspective is embedded in clinical workflows rather than collected in isolation and ignored.\r\n\r\nExample: A cancer center integrates patient-reported symptom scores collected between chemotherapy cycles into the oncology team's clinical dashboard. A pattern of worsening fatigue scores across multiple patients prompts a review of the current treatment protocol.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
