  "@type": "archimate:ApplicationComponent",
  "schema:identifier": "id-aae23aa58d6c4459ae5b8224140ced0f",
  "schema:name": "Educational Content Delivery Engine",
  "schema:description": "This component manages the storage, personalization, and delivery of patient education materials across formats including text, video, and audio.\r\n\r\nThe purpose of this component is to ensure that educational content reaches patients in a form they can understand and act on, regardless of language, literacy, or device. It also supports content management workflows that allow health authorities to update and maintain approved materials.\r\n\r\nExample: The engine automatically delivers a set of multilingual post-discharge care instructions to a patient based on their recorded language preference and diagnosis, formatted for mobile viewing.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
