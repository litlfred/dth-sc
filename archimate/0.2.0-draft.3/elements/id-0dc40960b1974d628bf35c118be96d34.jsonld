  "schema:identifier": "id-0dc40960b1974d628bf35c118be96d34",
  "schema:name": "Capture and digitize physical health records",
  "schema:description": "This process involves converting legacy paper-based medical files and historical documents into standardized, machine-readable digital formats. It uses scanning and indexing tools to integrate historical information into the modern TPHR infrastructure.\r\n\r\nIt eliminates data fragmentation by ensuring a patient’s entire medical history is accessible in a single digital environment. This supports clinical continuity by making past health events visible and searchable for current healthcare providers.\r\n\r\nA records department scanning a 10-year-old paper surgical report and uploading it as a verified PDF to the PHR.",
  "schema:category": "Business",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
