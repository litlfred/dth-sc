  "@type": "archimate:Outcome",
  "schema:identifier": "id-5a2fb03528534023a1b646cc16de609f",
  "schema:name": "Reduced inequities in per-capita allocations across regions/programmes.",
  "schema:description": "A high-impact equity outcome where the financial gap in healthcare spending between different geographic territories and medical initiatives is systematically closed, ensuring that every citizen commands a fair and comparable share of national health resources regardless of where they live.\r\n\r\nIts primary purpose is to eliminate structural discrimination in public funding, shifting the health system away from historical budgeting biases—which typically favor wealthy, politically connected urban centers—and directing resources toward historically neglected populations.\r\n\r\nExample: Achieving this reduced inequities outcome means that over a three-year period, the stark funding disparity between the capital city and a remote island province is slashed from a 400% gap to less than 15% on a per-person basis, guaranteeing that a rural villager has access to the same baseline level of clinic funding as an urban resident.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
