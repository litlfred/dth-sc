  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3/elements/id-ef25b58ee4e047c2a4b2723c653a32d7.jsonld",
  "@type": "archimate:Goal",
  "schema:identifier": "id-ef25b58ee4e047c2a4b2723c653a32d7",
  "schema:name": "A Central Health Workforce Registry",
  "schema:description": "The long-term strategic objective of establishing a unified, authoritative national system that houses and manages the data of all healthcare workers across the entire health system. This milestone aligns government, public health facilities, and private institutions under a single governance and operational standard for workforce data.\r\n\r\nAchieving this goal eliminates fragmented data silos, prevents credential fraud, and provides a clear picture of workforce distribution nationwide. For the organization, it establishes a foundational source of truth that guarantees payroll accuracy, simplifies licensing verification, and enables precise, data-driven workforce planning.\r\n\r\nExample: \"The national mandate to successfully launch and populate a Central Workforce Registry by Q4, onboarding all 150,000 public and private healthcare practitioners onto a single verified tracking platform.\"",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
