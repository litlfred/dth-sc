  "schema:identifier": "id-cfd09b58ed6b46c4916bba1dd06bdcd1",
  "schema:name": "Real-time dashboards of clinical quality indicators",
  "schema:description": "This outcome provide live visibility into healthcare performance metrics, operational trends, and patient safety indicators. It consolidates and visualizes quality data from multiple healthcare systems and facilities.\r\n\r\nThe purpose is to support timely monitoring, decision-making, and rapid response to emerging quality issues. They also improve transparency and operational oversight across healthcare organizations.\r\n\r\nExample: Hospital administrators monitor emergency room wait times and readmission rates through a centralized quality dashboard.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
