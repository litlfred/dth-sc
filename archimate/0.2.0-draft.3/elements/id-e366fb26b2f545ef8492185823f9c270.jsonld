  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3/elements/id-e366fb26b2f545ef8492185823f9c270.jsonld",
  "@type": "archimate:Goal",
  "schema:identifier": "id-e366fb26b2f545ef8492185823f9c270",
  "schema:name": "Ensure all health workers receive timely payments by adopting reliable digital payroll systems. This includes maintaining a health workforce registry to ensure qualification, retention, capacity building, and career development.",
  "schema:description": "The strategic objective focused on implementing robust digital payment infrastructures paired with a dynamic master registry to guarantee prompt compensation and structured professional support for the entire healthcare workforce.\r\n\r\nThe purpose of this goal is to eliminate payroll delays, minimize administrative discrepancies, and leverage workforce data to boost staff retention, plan targeted training, and secure sustainable career paths for health workers.\r\n\r\nExample: \"The successful adoption of this comprehensive registry and payroll goal ensured that remote, rural health workers received their monthly salaries and hazard pay directly to their mobile wallets on time, while simultaneously tracking their eligibility for upcoming senior promotions.\"",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
