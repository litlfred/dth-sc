  "schema:identifier": "id-a7d4b0c937c44163859b58e95b17140a",
  "schema:name": "Healthcare Facilities",
  "schema:description": "Healthcare facilities are the organizations, such as hospitals and clinics, that provide medical services and host the infrastructure for patient care. They act as the nodes in the interoperable health network that contribute to and consume shared records.\r\n\r\nThe purpose is to enable seamless continuity of care through interoperable patient records and reduced administrative overhead. This leads to improved operational efficiency and higher quality of clinical service delivery.\r\n\r\nExample: A regional hospital receiving an automated referral and clinical summary from a remote primary care center.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
