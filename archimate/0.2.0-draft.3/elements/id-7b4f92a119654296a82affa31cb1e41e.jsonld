  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3/elements/id-7b4f92a119654296a82affa31cb1e41e.jsonld",
  "@type": "archimate:Goal",
  "schema:identifier": "id-7b4f92a119654296a82affa31cb1e41e",
  "schema:name": "Establish a secure, universally accessible, verifiable health record for every individual",
  "schema:description": "This sub-goal aims to create a national infrastructure where every citizen has a digital health record that is secure and universally available. It focuses on issuing verifiable credentials that can be used across the entire care continuum.\r\n\r\nThe purpose is to ensure life-long health data portability and continuity of care for all individuals. It addresses the \"Right to Health\" by providing an equitable and person-centric data ownership model.\r\n\r\nExample: A national mandate to issue a digital health identity and record to every newborn and existing citizen.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
