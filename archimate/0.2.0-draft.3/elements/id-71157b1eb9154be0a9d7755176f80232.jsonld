  "@type": "archimate:Stakeholder",
  "schema:identifier": "id-71157b1eb9154be0a9d7755176f80232",
  "schema:name": "Patients",
  "schema:description": "Patients are the individual users of the health system who seek financial protection from high medical costs and the security of their personal information. They are the ultimate reason for health financing mechanisms like insurance and subsidies.\r\n\r\nThe purpose is to gain financial protection from health shocks and ensure their data is used securely and privately. They value affordable access to care, clear information about their entitlements, and the peace of mind that their records are safe.\r\n\r\nExample: A low-income mother receiving free maternity care because her digital insurance enrollment was automatically verified at the hospital.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
