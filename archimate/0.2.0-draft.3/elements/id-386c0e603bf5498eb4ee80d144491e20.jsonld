  "schema:identifier": "id-386c0e603bf5498eb4ee80d144491e20",
  "schema:name": "Terminology Service (SNOMED, ICD, LOINC)",
  "schema:description": "This service provides the technical interface to identify, authenticate, and link individuals within the health system. It often bridges the gap between local health IDs and a national identity registry.\r\n\r\nThe purpose is to ensure that every clinical record is accurately associated with the correct physical person. This is foundational for patient safety and the creation of longitudinal medical histories.\r\n\r\nExample: A service that validates a patient’s fingerprint against the national ID database during hospital check-in.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
