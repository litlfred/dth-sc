  "@type": "archimate:Outcome",
  "schema:identifier": "id-1e118a77dd4545c5ba2c74fe2fb591b5",
  "schema:name": "Stronger ecosystem trust, fewer breaches",
  "schema:description": "This outcome represents a secure health data environment where cybersecurity incidents are rare and trust among all participants is high. It is the result of effective safeguards, trust services, and rapid incident response.\r\n\r\nThe purpose is to protect the integrity of the health system and prevent the harmful social and clinical consequences of data breaches. A trusted ecosystem is essential for the sustainable exchange of sensitive medical information.\r\n\r\nExample: A year-over-year reduction in reported data breaches and unauthorized access incidents across the PHR network.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
