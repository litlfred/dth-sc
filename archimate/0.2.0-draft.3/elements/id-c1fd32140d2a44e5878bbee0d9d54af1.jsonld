  "schema:identifier": "id-c1fd32140d2a44e5878bbee0d9d54af1",
  "schema:name": "PHR Portal/Mobile App",
  "schema:description": "The PHR Portal/Mobile App is a user-facing digital interface that allows individuals to access, manage, and share their personal health information. It serves as the primary interaction point for citizens to engage with their Trusted Personal Health Record and manage their wellness.\r\n\r\nIts purpose is to empower patients by providing them with direct access to their own medical data and health services. It facilitates patient-provider communication and promotes self-management of health conditions through digital engagement and access control.\r\n\r\nExample: A mobile application where a citizen can download their verifiable vaccination certificates and lab test results to share with a provider.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
