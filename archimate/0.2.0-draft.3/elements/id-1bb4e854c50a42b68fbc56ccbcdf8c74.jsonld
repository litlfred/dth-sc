  "schema:identifier": "id-1bb4e854c50a42b68fbc56ccbcdf8c74",
  "schema:name": "Client Registry",
  "schema:description": "The Client Registry is a master patient index and identity provider that manages demographic details and unique identifiers for health system users. It maintains relationships among records to handle merged or linked identities across different health programs and facilities.\r\n\r\nIts purpose is to provide a unique, verifiable patient identity that links medical records across disparate and fragmented sources. It ensures accurate patient identification, which is critical for patient safety and the creation of longitudinal health records.\r\n\r\nExample: A central system that maps a citizen's national ID to their specific medical record IDs in multiple regional hospitals.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
