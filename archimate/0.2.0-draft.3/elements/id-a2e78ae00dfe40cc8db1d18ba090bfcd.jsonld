  "@type": "archimate:Capability",
  "schema:identifier": "id-a2e78ae00dfe40cc8db1d18ba090bfcd",
  "schema:name": "Fraud detection & prevention",
  "schema:description": "This capability focuses on the proactive measures used to stop fraudulent financial activity before it results in a loss of funds. it includes real-time blocks on suspicious transactions and the continuous improvement of risk-scoring models.\r\n\r\nThe purpose is to actively safeguard the financial health of the sector by reducing fraud losses and administrative errors. It creates a deterrent effect that discourages systemic abuse of health insurance and public funds.\r\n\r\nExample: A real-time block on a claim where the patient's ID is being used simultaneously at two different facilities 500 miles apart.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
