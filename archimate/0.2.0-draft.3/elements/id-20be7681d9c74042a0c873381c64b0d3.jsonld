  "schema:identifier": "id-20be7681d9c74042a0c873381c64b0d3",
  "schema:name": "National Health worker Training and Competency Framework Catalogue",
  "schema:description": "The master, authoritative registry that standardizes the curriculum requirements, continuing education milestones, and specific clinical competencies recognized across all levels of the national healthcare workforce.\r\n\r\nThe purpose of this catalog is to establish a uniform, transparent benchmark for medical education and career advancement, ensuring that training programs nationwide align directly with evolving public health standards.\r\n\r\nExample: \"The implementation of the National Health Worker Training and Competency Framework Catalogue allowed the accreditation board to quickly audit a new university's nursing curriculum against required national emergency care standards.\"",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
