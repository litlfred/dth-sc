  "@type": "archimate:Outcome",
  "schema:identifier": "id-6bfbbb64740b474390519957098c7470",
  "schema:name": "Outcome",
  "schema:description": "An end result, effect, or consequence of a certain state of affairs. \n\nA Business Outcome is what is actually achieved by implementing capabilities—it is the tangible, often measurable result. Outcomes are frequently tied to KPIs and may be time-bound. Outcomes can also be used to model potentially unwanted effects; for example, in order to design appropriate mitigating measures.\n\nFor example, “80% of citizens issued with a verifiable health record” or “90% of adverse events reported within 24 hours”. Outcomes demonstrate whether the architecture is delivering on its goals.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
