  "@type": "archimate:Stakeholder",
  "schema:identifier": "id-bf545ab55f0c48269e4761a07de44271",
  "schema:name": "Government Officials",
  "schema:description": "These are high-level authorities in the Ministry of Finance and Ministry of Health responsible for national budgeting and sector oversight. They manage the primary pool of health funds and set the strategic financial direction for the country.\r\n\r\nThe purpose is to achieve accurate, timely forecasting and budgeting to ensure the health system remains solvent and equitable. They value the ability to see how national funds are being translated into health services and outcomes.\r\n\r\nExample: A budget director using an analytics report to justify an increase in the primary healthcare budget for the next fiscal year.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.3.jsonld"
}
