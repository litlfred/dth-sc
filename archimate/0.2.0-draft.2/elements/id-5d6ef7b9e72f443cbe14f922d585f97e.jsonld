  "schema:identifier": "id-5d6ef7b9e72f443cbe14f922d585f97e",
  "schema:name": "Audit Log Service",
  "schema:description": "This service provides the infrastructure for logging system activities and enforcing data protection policies like encryption. It ensures that all actions are traceable and that data at rest and in transit is secured.\r\n\r\nThe purpose is to maintain a secure and accountable environment for health data. It supports regulatory audits and helps detect potential security threats or privacy violations.\r\n\r\nExample: A service that encrypts all clinical notes before they are saved to the primary database.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
