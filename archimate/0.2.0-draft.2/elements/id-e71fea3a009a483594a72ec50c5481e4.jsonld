  "@type": "archimate:Capability",
  "schema:identifier": "id-e71fea3a009a483594a72ec50c5481e4",
  "schema:name": "Continuous Quality Measurement and Improvement",
  "schema:description": "This capability systematically monitors healthcare performance using standardized quality indicators and improvement processes. It supports ongoing assessment and enhancement of healthcare delivery and patient outcomes.\r\n\r\nThe purpose is to enable healthcare organizations to identify performance gaps and implement targeted quality improvement initiatives. It also promotes continuous learning and evidence-based healthcare management.\r\n\r\nExample: A hospital continuously tracks surgical infection rates and implements corrective actions when performance declines.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
