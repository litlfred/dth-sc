  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2/elements/id-56e9dfb023c14b5093fe8f198608231a.jsonld",
  "@type": "archimate:Capability",
  "schema:identifier": "id-56e9dfb023c14b5093fe8f198608231a",
  "schema:name": "Revenue performance analytics (ability to monitor yield, leakage, and compliance).",
  "schema:description": "An advanced analytical capability that combines business intelligence and data modeling to actively track total financial intake, pinpoint where money is being lost, and monitor how well citizens and businesses follow tax laws.\r\n\r\nIts primary purpose is to provide tax and health authorities with a clear, data-driven picture of the system's financial health so they can fix weak collection points, predict future budgets, and maximize funding for care.\r\n\r\nExample: Using this performance analytics capability, the ministry runs an automated quarterly review that reveals a specific commercial sector is underpaying its health contributions by 8%, allowing the government to deploy targeted audits to recover the missing revenue and plug the leakage.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
