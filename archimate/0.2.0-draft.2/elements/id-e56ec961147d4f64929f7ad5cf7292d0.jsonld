  "@type": "archimate:Capability",
  "schema:identifier": "id-e56ec961147d4f64929f7ad5cf7292d0",
  "schema:name": "Identity & access management",
  "schema:description": "This capability manages the digital identities and permissions of all people and systems that interact with health financing tools. It ensures that every action in the system is performed by a verified user with the appropriate legal authority.\r\n\r\nThe goal is to protect the security and integrity of health funds by preventing unauthorized access to sensitive financial operations. It provides the high-level governance needed to manage the \"who, what, and when\" of system usage.\r\n\r\nExample: Restricting the ability to approve multi-million dollar hospital payment schedules to only the most senior financial officials.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
