  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2/elements/id-b1a1f8da16ea4e308244629d00faf4e8.jsonld",
  "@type": "archimate:Outcome",
  "schema:identifier": "id-b1a1f8da16ea4e308244629d00faf4e8",
  "schema:name": "Higher patient satisfaction and trust in the health system.",
  "schema:description": "This outcome reflects the measurable improvement in how patients and families perceive the quality, responsiveness, and respect embedded in their care experience. \r\n\r\nThe purpose of this outcome is to strengthen the relationship between patients and the health system by demonstrating that their preferences, concerns, and experiences are heard and acted upon. It also supports long-term health system sustainability by building a patient population that engages proactively with care rather than avoiding it.\r\n\r\nExample: Following the introduction of a patient engagement portal, a district hospital records a significant increase in patient satisfaction scores, with patients citing improved access to their health information and faster responses from their care team as the primary reasons.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
