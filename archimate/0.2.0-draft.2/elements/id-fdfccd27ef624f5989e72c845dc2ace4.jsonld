  "schema:identifier": "id-fdfccd27ef624f5989e72c845dc2ace4",
  "schema:name": "Standard Terminology Services",
  "schema:description": "This service provides a centralized source for standardized clinical codes and vocabularies. It supports the translation and mapping between different medical coding systems.\r\n\r\nThe purpose is to ensure that clinical data retains its meaning as it moves between different healthcare systems. This is the technical enabler for semantic interoperability and meaningful analytics.\r\n\r\nExample: A service that tells a reporting system that the local code \"C-19\" should be mapped to the ICD-10 code \"U07.1\".",
  "schema:category": "Business",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
