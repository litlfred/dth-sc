  "@type": "archimate:ValueStream",
  "schema:identifier": "id-71edfe145d0b4330915f853c28e4498e",
  "schema:name": "Member Protection & Entitlement Management",
  "schema:description": "This value stream focuses on enrolling individuals into health insurance schemes and managing their specific benefit entitlements. It identifies eligible populations and ensures they are protected from financial hardship caused by medical costs.\r\n\r\nThe intent is to provide universal financial protection and ensure citizens can access their covered health benefits at the point of care. It reduces out-of-pocket spending and safeguards individuals from catastrophic health-related debts.\r\n\r\nExample: An automated system that verifies a citizen's insurance coverage and applies the correct subsidy during a hospital visit.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
