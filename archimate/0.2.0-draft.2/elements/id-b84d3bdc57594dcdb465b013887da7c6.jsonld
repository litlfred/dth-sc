  "schema:identifier": "id-b84d3bdc57594dcdb465b013887da7c6",
  "schema:name": "Trusted Personal Health Record (PHR)",
  "schema:description": "The TPHR is a verifiable and secure digital record of an individual's health information that is owned and governed by the individual. It serves as the primary tool for citizens to interact with their health data.\r\n\r\nThe purpose is to empower individuals with their own data and ensure it can be used across the entire health system. It provides a portable medical identity that follows the patient wherever they seek care.\r\n\r\nExample: A government-issued \"Health Wallet\" app that allows citizens to store and share their medical history.",
  "schema:category": "Business",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
