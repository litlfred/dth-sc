  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2/elements/id-ba1cc1772d824cb6a9f72fd8222bf36b.jsonld",
  "@type": "archimate:Goal",
  "schema:identifier": "id-ba1cc1772d824cb6a9f72fd8222bf36b",
  "schema:name": "Quality monitoring and improvement",
  "schema:description": "This sub-goal enables healthcare organizations to continuously measure, assess, and enhance the quality of healthcare services and patient outcomes. It uses standardized indicators, analytics, and feedback mechanisms to identify performance gaps and improvement opportunities.\r\n\r\nThe purpose is to support evidence-based quality management and strengthens accountability across healthcare systems. It also promotes safer, more consistent, and more equitable healthcare delivery.\r\n\r\nExample: A health authority monitors hospital infection rates and implements targeted interventions for facilities with poor performance trends.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
