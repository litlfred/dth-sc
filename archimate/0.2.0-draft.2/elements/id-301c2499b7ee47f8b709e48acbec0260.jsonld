  "@type": "archimate:Outcome",
  "schema:identifier": "id-301c2499b7ee47f8b709e48acbec0260",
  "schema:name": "Tariff compliance measurable. ",
  "schema:description": "This outcome means that the health system can objectively prove that providers are billing exactly according to agreed-upon national or regional price lists. It involves automated monitoring of billing patterns against established tariff standards for all medical services.\r\n\r\nIt prevents cost escalation and ensures that health funds are used strictly according to the established contracts. Measurability allows for the proactive detection and correction of over-billing or accidental coding errors by facilities.\r\n\r\nExample: An audit dashboard showing that 100% of claims for standardized maternity care packages were billed at the correct national rate.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
