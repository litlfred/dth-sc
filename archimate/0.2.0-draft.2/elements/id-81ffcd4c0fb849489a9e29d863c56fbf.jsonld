  "schema:identifier": "id-81ffcd4c0fb849489a9e29d863c56fbf",
  "schema:name": "Terminology Service",
  "schema:description": "The Terminology Service metadata component manages code systems, value sets, and concept mappings to standardize health data semantics. It ensures that clinical concepts are represented consistently throughout the national health record.\r\n\r\nThe purpose is to ensure that medical records have a consistent and verifiable content structure across all sources. It enables interoperable communication and allows for effective automated analysis of population health trends.\r\n\r\nExample: A metadata registry of value sets that defines the specific codes for \"allergic reactions\" to be used in all digital health apps.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
