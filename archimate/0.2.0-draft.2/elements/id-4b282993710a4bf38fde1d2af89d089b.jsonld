  "schema:identifier": "id-4b282993710a4bf38fde1d2af89d089b",
  "schema:name": "Patient-level feedback mechanisms integrated into quality reports",
  "schema:description": "This outcome collects and integrates patient experiences, satisfaction data, and outcome feedback into healthcare quality reporting processes. It provides insights into care quality from the patient perspective.\r\n\r\nThe purpose is to strengthen patient-centered care and improve the responsiveness of healthcare services. They also support continuous quality improvement based on patient experiences and outcomes.\r\n\r\nExample: Patient satisfaction survey results are included in hospital quality performance reports reviewed by management teams.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
