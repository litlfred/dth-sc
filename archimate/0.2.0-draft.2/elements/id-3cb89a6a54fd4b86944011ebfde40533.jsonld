  "@type": "archimate:ApplicationService",
  "schema:identifier": "id-3cb89a6a54fd4b86944011ebfde40533",
  "schema:name": "Family & Caregiver Access Service",
  "schema:description": "This service enables patients to grant controlled access to family members or caregivers, allowing them to view health information, receive updates, and participate in care coordination on behalf of the patient. \r\n\r\nThe purpose of this service is to recognize the critical role that families and caregivers play in supporting adherence, safety, and recovery, and to include them appropriately in the care process. \r\n\r\nExample: An elderly patient grants her daughter caregiver access to her health portal, allowing the daughter to receive medication reminders, view upcoming appointments, and communicate with the care team on her behalf.",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
