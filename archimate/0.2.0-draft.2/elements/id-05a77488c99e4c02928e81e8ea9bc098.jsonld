  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2/elements/id-05a77488c99e4c02928e81e8ea9bc098.jsonld",
  "@type": "archimate:Outcome",
  "schema:identifier": "id-05a77488c99e4c02928e81e8ea9bc098",
  "schema:name": "Patients and families access their longitudinal care plan in clear, understandable formats.",
  "schema:description": "This outcome ensures that patients and families can view their full care journey through digital interfaces that present clinical information in plain, accessible language. It makes the care plan a living document that patients and families can refer to, rather than a record kept solely within clinical systems.\r\n\r\nThe purpose of this outcome is to bridge the gap between clinical documentation and patient understanding. It also reduces confusion and anxiety by giving patients and families a clear, consistent picture of what is planned and why.\r\n\r\nExample: A patient managing multiple chronic conditions logs into the health portal and views a simplified timeline of their care plan, showing upcoming appointments, current medications, and progress toward their blood pressure and weight targets in plain language.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
