  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2/elements/id-b6bc801d5df44f6aa007fca9eb15807e.jsonld",
  "@type": "archimate:Goal",
  "schema:identifier": "id-b6bc801d5df44f6aa007fca9eb15807e",
  "schema:name": "Develop a secure and universally accessible system for issuing verifiable digital health records to individuals for their utilization as they seek care, following appropriate safeguards for privacy, security and consent",
  "schema:description": "This goal involves establishing a secure and universally accessible infrastructure for issuing verifiable digital health records to all individuals. It creates a standardized system where personal medical data is portable and remains under the individual's control as they move through the healthcare system.\r\n\r\nThe purpose is to foster patient empowerment and ensure seamless continuity of care by providing trusted data at the point of service. It aims to reduce clinical errors and administrative fragmentation through a robust framework for privacy, security, and informed consent.\r\n\r\nExample: A national digital health app that allows citizens to receive, store, and present verifiable medical certificates and lab results during consultations.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
