  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2/elements/id-ae58862b863a45209cf7cc8dc4c5396c.jsonld",
  "@type": "archimate:Outcome",
  "schema:identifier": "id-ae58862b863a45209cf7cc8dc4c5396c",
  "schema:name": "Increased patient trust and adoption",
  "schema:description": "This outcome reflects the success of privacy, security, and value-added services in encouraging citizens to actively use their PHR. It is measured through user engagement, consent participation, and positive public sentiment.\r\n\r\nThe purpose is to ensure the long-term viability of the digital health system through active citizen participation. High adoption rates are necessary to realize the full potential of integrated care and population health management.\r\n\r\nExample: A significant increase in citizens regularly logging into their PHR to view results and manage their care.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
