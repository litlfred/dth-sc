  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2/elements/id-8e0540f0b750475c84b6d7fe268eea82.jsonld",
  "@type": "archimate:Outcome",
  "schema:identifier": "id-8e0540f0b750475c84b6d7fe268eea82",
  "schema:name": "Establishment of Authoritative National Health Workforce Registry",
  "schema:description": "The definitive, measurable achievement of launching a fully operational, legally backed, and universally adopted national repository that serves as the single source of truth for health worker data. This milestone signifies that all public and private healthcare practitioners are officially registered, verified, and trackable within a unified ecosystem.\r\n\r\nReaching this outcome guarantees absolute data integrity across the health sector, eliminating ghost workers, credential fraud, and administrative silos. For payroll and operational management, it delivers an active, trusted baseline that automates compliance, secures funding distributions, and enables precise national-level workforce planning.\r\n\r\nExample: \"The official signing and system-wide enforcement of the fully populated National Health Workforce Registry, which successfully cross-references 100% of practicing clinicians against active professional licenses.\"",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
