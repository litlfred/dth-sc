  "@type": "archimate:Capability",
  "schema:identifier": "id-988039459490443a94db25a0a3b3739a",
  "schema:name": "Universal Access Enablement",
  "schema:description": "This capability ensures that personal health services and records are accessible to all citizens through multiple channels, including web portals and mobile devices. It focuses on inclusivity and reducing barriers to health information access.\r\n\r\nThe purpose is to drive widespread adoption and ensure that all individuals, regardless of their location or device, can benefit from their health data. This supports the goal of equitable access to modern health services.\r\n\r\nExample: A multi-channel PHR portal that works on both high-end smartphones and basic feature phones via USSD.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
