  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2/elements/id-c0715bcb11cf4837ad93493ca9ae10ac.jsonld",
  "@type": "archimate:Goal",
  "schema:identifier": "id-c0715bcb11cf4837ad93493ca9ae10ac",
  "schema:name": "Support interoperability across providers, facilities, and jurisdictions",
  "schema:description": "This subgoal focuses on eliminating data silos by adopting standardized protocols and clinical terminologies for seamless information exchange. It enables health data to flow accurately and meaningfully between different facilities and geographic regions.\r\n\r\nThe purpose is to reduce record fragmentation and improve care coordination by ensuring patient data is machine-readable by any authorized system. It supports global mobility and effective public health monitoring through the use of standardized data formats.\r\n\r\nRequiring all public and private hospitals to use the HL7 FHIR standard for sharing clinical summaries.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
