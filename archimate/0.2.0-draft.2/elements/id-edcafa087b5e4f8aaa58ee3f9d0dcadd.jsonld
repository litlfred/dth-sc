  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2/elements/id-edcafa087b5e4f8aaa58ee3f9d0dcadd.jsonld",
  "@type": "archimate:Outcome",
  "schema:identifier": "id-edcafa087b5e4f8aaa58ee3f9d0dcadd",
  "schema:name": "Population has verifiable digital health records",
  "schema:description": "This outcome is achieved when the majority of citizens are issued secure, digital health credentials that are recognized across the country. It signifies the transition from paper-based or fragmented records to a trusted national digital infrastructure.\r\n\r\nThe purpose is to provide a foundation for modern, data-driven healthcare that is person-centric and portable. It enables the systemic benefits of improved data quality, better care coordination, and citizen empowerment.\r\n\r\nExample: 90% of the population possessing a digital health record that is recognized by all public and private providers.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
