  "schema:identifier": "id-8b67470531fb4599ac267b05edbf7357",
  "schema:name": "Incident Detection & Response",
  "schema:description": "This capability involves the proactive monitoring of the health ecosystem for cybersecurity incidents and the execution of response plans when breaches occur. It aims to minimize the impact of security events on system operations and data privacy.\r\n\r\nThe purpose is to ensure the resilience of the health infrastructure and provide a rapid recovery mechanism after a security event. This protects the continuity of care and the integrity of the health data network.\r\n\r\nExample: A Security Operations Center (SOC) that detects and blocks a brute-force attack on the PHR login portal.",
  "schema:category": "Strategy",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
