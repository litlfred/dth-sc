  "schema:identifier": "id-524dea71aa26495883e2ab4efbca3075",
  "schema:name": "Learning Management & Training Tracking Systems",
  "schema:description": "The foundational software applications and platform infrastructure used to host, deliver, administer, and comprehensively document formal educational courses, certifications, and continuing professional development programs for the healthcare workforce.\r\n\r\nThe purpose of these systems is to centralize the delivery of digital and blended learning content, automate the enrollment and scheduling of mandatory training, and maintain a permanent, auditable ledger of all training completions across the health system.\r\n\r\nExample: \"The migration to enterprise Learning Management & Training Tracking Systems allowed the Ministry of Health to deploy an updated infectious disease protocol to 50,000 distributed health workers simultaneously and track their completion rates within a single dashboard.\"",
  "schema:category": "Application",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
