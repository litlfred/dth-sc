  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2/elements/id-2bd8fe59447a4ebe9a92e4c0409d2ee6.jsonld",
  "@type": "archimate:Outcome",
  "schema:identifier": "id-2bd8fe59447a4ebe9a92e4c0409d2ee6",
  "schema:name": "Provider payment plans executed on time.",
  "schema:description": "This refers to the reliable and scheduled disbursement of funds to healthcare facilities according to pre-agreed timelines. It covers all types of payments, including capitation, global grants, or fee-for-service settlements.\r\n\r\nIt ensures that hospitals and clinics have the necessary liquidity to pay staff, purchase medical supplies, and maintain their infrastructure. Reliable payments prevent service disruptions and maintain the morale and stability of the healthcare workforce.\r\n\r\nExample: A national health fund successfully transferring monthly payments to all participating primary care clinics by the 25th of every month.",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
