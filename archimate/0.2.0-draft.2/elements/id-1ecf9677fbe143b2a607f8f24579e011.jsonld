  "@id": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2/elements/id-1ecf9677fbe143b2a607f8f24579e011.jsonld",
  "@type": "archimate:Outcome",
  "schema:identifier": "id-1ecf9677fbe143b2a607f8f24579e011",
  "schema:name": "Availability of National Workforce to Location Analytics",
  "schema:description": "The definitive, measurable achievement of exposing live, aggregated, and geo-referenced health worker registry data to advanced spatial analysis and mapping tools. This milestone signifies that decision-makers can instantly visualize the real-time distribution, density, and specialization of the healthcare workforce against specific geographic coordinates and facility locations.\r\n\r\nReaching this outcome eliminates static spreadsheets and blind spots in rural healthcare management, allowing leadership to instantly identify staffing shortages and over-supply zones. For payroll and operational planning, it enables data-driven budget modeling, allowing the organization to strategically deploy financial incentives, hazard pay, and regional allowances exactly where the workforce is most critically needed.\r\n\r\nExample: \"The launch of the National Workforce Location Analytics pipeline, enabling the Ministry of Health to overlay real-time nursing shortages with regional payroll data to dynamically allocate rural retention bonuses.\"",
  "schema:category": "Motivation",
  "dcterms:isPartOf": "https://litlfred.github.io/smart-ra/archimate/0.2.0-draft.2.jsonld"
}
