    "ValueStream" [label="Value Stream
21 element(s)
(to itself: triggers ×13, composed of ×2)", class="mm-layer-strategy", fillcolor="#f5deaa", URL="../../en/dpi-h-ra/archimate/0.2.0-draft.2/metamodel/#type-ValueStream", target="_top", tooltip="Value Stream: its elements"];
