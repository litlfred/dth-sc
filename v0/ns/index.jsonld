  "@id": "https://worldhealthorganization.github.io/dth-sc/v0/ns/",
  "@type": "owl:Ontology",
  "label": "dth-sc namespace",
  "@graph": [
    {
      "@id": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc",
      "@type": "skos:ConceptScheme",
      "prefLabel": "Glossary of the Digital Transformation Handbook for Health Supply Chain Architecture",
      "definition": "The handbook's supply chain terms, one concept per term, each quoting the handbook's own definition with its L1 page. General digital terms (digital health, interoperability, registry, enterprise architecture and the rest of the handbook's glossary) are NOT minted here: they are held once in smart-ra, with this handbook's wording as a cited alternative (litlfred/smart-ra#140, #183). Every term is a candidate: only a person adopts a definition. Each term links via SKOS broadMatch/closeMatch/related to the dpi-h-ra concept it narrows or relates to (smart-ra#133 S1, dth-sc#2 SC2b). Concept labels are Capitalized (owner ruling, 2026-10-31, relayed from the dth-pc thread). Trade Item and Product Master Data are defined in dth-pc, not here (smart-ra#142). Acronyms (owner, 2026-10-31): every acronym the handbook uses is a term here with the acronym as notation, unless smart-ra already holds it (FHIR). Organizations several handbooks name live once in smart-ra's organizations scheme and are listed under members; organizations only this handbook names (DH&I WG, DHI, USAID GHSC-PSM, HTSS, IHE, ICMRA, PtD, ASCM, BUFMAR, DAI) are terms here with a foaf:focus to a W3C ORG organization (litlfred/folio-assistant-core#411).",
      "isDefinedBy": "https://worldhealthorganization.github.io/dth-sc/v0/ns/",
      "seeAlso": "../../assets/glossary/dth-sc--dth-sc.skos.jsonld"
    },
    {
      "@id": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc/digital-health-supply-chain",
      "@type": "skos:Concept",
      "inScheme": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc",
      "prefLabel": "Digital Health Supply Chain",
      "definition": "The knowledge and practice of adopting digital technologies to improve health supply chains and enable the delivery of quality-assured health products to individuals when and where they need them.",
      "isDefinedBy": "https://worldhealthorganization.github.io/dth-sc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-sc/dth-sc/digital-health-supply-chain/"
    },
    {
      "@id": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc/digital-health-supply-chain-intervention",
      "@type": "skos:Concept",
      "inScheme": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc",
      "prefLabel": "Digital Health Supply Chain Intervention",
      "definition": "An intervention that involves the use of digital technologies to improve the management and operation of health supply chains. It aims to enhance the efficiency and effectiveness of health supply chain processes such as planning, procurement, distribution and warehouse management.",
      "isDefinedBy": "https://worldhealthorganization.github.io/dth-sc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-sc/dth-sc/digital-health-supply-chain-intervention/"
    },
    {
      "@id": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc/health-supply-chain-information-system",
      "@type": "skos:Concept",
      "inScheme": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc",
      "prefLabel": "Health Supply Chain Information System",
      "definition": "A paper-based or software tool that supports the management and/or operations of the health supply chain. Such software tools (e.g., for order management or warehouse management) are also commonly referred to as electronic logistics management information systems.",
      "isDefinedBy": "https://worldhealthorganization.github.io/dth-sc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-sc/dth-sc/health-supply-chain-information-system/"
    },
    {
      "@id": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc/order-management",
      "@type": "skos:Concept",
      "inScheme": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc",
      "prefLabel": "Order Management",
      "definition": "The planning, directing, monitoring and controlling of the processes related to customer or requisition orders. Order management includes order promising; order entry; order pick, pack and ship; billing; and reconciliation of the customer account.",
      "isDefinedBy": "https://worldhealthorganization.github.io/dth-sc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-sc/dth-sc/order-management/"
    },
    {
      "@id": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc/order-management-system",
      "@type": "skos:Concept",
      "inScheme": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc",
      "prefLabel": "Order Management System",
      "definition": "A paper-based or software tool that supports the processes for fulfilling requisition orders (e.g., a software tool that supports entry and processing of requisition orders from health facilities to regional or central warehouses to replenish inventory).",
      "isDefinedBy": "https://worldhealthorganization.github.io/dth-sc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-sc/dth-sc/order-management-system/"
    },
    {
      "@id": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc/warehouse-management-system",
      "@type": "skos:Concept",
      "inScheme": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc",
      "prefLabel": "Warehouse Management System",
      "definition": "A computer application that manages and optimizes workflows and the storage of goods within a warehouse. It often interfaces with automated data capture and enterprise resource planning systems.",
      "isDefinedBy": "https://worldhealthorganization.github.io/dth-sc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-sc/dth-sc/warehouse-management-system/"
    },
    {
      "@id": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc/governance-health-supply-chain",
      "@type": "skos:Concept",
      "inScheme": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc",
      "prefLabel": "Governance (Health Supply Chain)",
      "definition": "In the context of the health supply chain, the process of establishing and implementing policies, procedures and mechanisms to ensure that the supply chain processes and the systems to manage those processes are managed effectively, ethically and in alignment with established objectives and stakeholders' interests.",
      "isDefinedBy": "https://worldhealthorganization.github.io/dth-sc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-sc/dth-sc/governance-health-supply-chain/"
    },
    {
      "@id": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc/traceability",
      "@type": "skos:Concept",
      "inScheme": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc",
      "prefLabel": "Traceability",
      "definition": "The ability to trace something. In some cases, it is interpreted as the ability to verify the history, location or application of an item by means of documented identification.",
      "isDefinedBy": "https://worldhealthorganization.github.io/dth-sc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-sc/dth-sc/traceability/"
    },
    {
      "@id": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc/traceability-model",
      "@type": "skos:Concept",
      "inScheme": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc",
      "prefLabel": "Traceability Model",
      "definition": "One of the three main models for implementing traceability (centralized, semi-centralized, distributed), which differ mostly in how they store traceability data and share them with the relevant health authority and across actors in the supply chain.",
      "isDefinedBy": "https://worldhealthorganization.github.io/dth-sc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-sc/dth-sc/traceability-model/"
    },
    {
      "@id": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc/centralized-traceability-model",
      "@type": "skos:Concept",
      "inScheme": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc",
      "prefLabel": "Centralized Traceability Model",
      "definition": "A traceability model that involves a single database or repository for storing all traceability data.",
      "isDefinedBy": "https://worldhealthorganization.github.io/dth-sc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-sc/dth-sc/centralized-traceability-model/"
    },
    {
      "@id": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc/semi-centralized-traceability-model",
      "@type": "skos:Concept",
      "inScheme": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc",
      "prefLabel": "Semi-Centralized Traceability Model",
      "definition": "A traceability model in which the traceability data are spread across multiple databases or repositories.",
      "isDefinedBy": "https://worldhealthorganization.github.io/dth-sc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-sc/dth-sc/semi-centralized-traceability-model/"
    },
    {
      "@id": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc/distributed-traceability-model",
      "@type": "skos:Concept",
      "inScheme": "https://worldhealthorganization.github.io/dth-sc/v0/ns/glossary/dth-sc",
      "prefLabel": "Distributed Traceability Model",
      "definition": "A traceability model in which traceability data are maintained separately by each supply chain partner.",
      "isDefinedBy": "https://worldhealthorganization.github.io/dth-sc/v0/ns/",
      "seeAlso": "../../en/folio-assistant-core/glossary/instance/dth-sc/dth-sc/distributed-traceability-model/"
    },
