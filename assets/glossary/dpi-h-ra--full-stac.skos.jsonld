    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/full-stac/open-standards",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/full-stac"
      },
      "skos:prefLabel": [
        {
          "@value": "Open Standards"
        }
      ],
      "skos:definition": [
        {
          "@value": "Semantic and syntactic models for data representation, exchange, and processing that ensure the precise meaning of exchanged information is unambiguously interpretable by any other system, service, or user. Open standards are developed and maintained through collaborative, consensus-driven processes, and are freely available for use and adaptation without license restrictions."
        }
      ],
      "skos:scopeNote": "Transcribed from Figure 1 (p. 2). The figure's text is drawn as outlines, so the ingest could not extract it (vector-figures.json: vfig-p002 unrendered); the transcription was read off a 220 dpi render of the page on 2026-10-31 and needs a person to confirm it. Example given in the figure: shared FHIR profiles with standard ontologies. The body text also says: 'OPEN STANDARDS refers to a common schema for health data, calculations and information exchange.'",
      "dcterms:source": "library/mehl-2023-full-stac-oqad018/sections/sec-000-a-full-stac-remedy-for-global-digital-health-tra.md#figure-1",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/full-stac/open-technologies",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/full-stac"
      },
      "skos:prefLabel": [
        {
          "@value": "Open Technologies"
        }
      ],
      "skos:definition": [
        {
          "@value": "Modular, standards-based, and accessible software tools that help developers and users to collect, store, transmit, or analyze data represented in open standards. Open technologies are developed and maintained through transparent, community-based processes, and are licensed under an open-source software license."
        }
      ],
      "skos:scopeNote": "Transcribed from Figure 1 (p. 2). The figure's text is drawn as outlines, so the ingest could not extract it (vector-figures.json: vfig-p002 unrendered); the transcription was read off a 220 dpi render of the page on 2026-10-31 and needs a person to confirm it. Example given in the figure: the Open Health Stack Android FHIR SDK. The body adds: 'Open technologies are open-source and use open standards.'",
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/full-stac/open-standards"
        }
      ],
      "dcterms:source": "library/mehl-2023-full-stac-oqad018/sections/sec-000-a-full-stac-remedy-for-global-digital-health-tra.md#figure-1",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/full-stac/open-architectures",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/full-stac"
      },
      "skos:prefLabel": [
        {
          "@value": "Open Architectures"
        }
      ],
      "skos:definition": [
        {
          "@value": "Documentation, using open standards, of reusable enterprise architecture patterns for health systems, describing the diverse digital interconnections of systems and capabilities (including trust networks, services, registries, access controls). Open architectures are designed to be instantiable via open technologies; provide a core infrastructure that fosters an ecosystem of digital health tools; are developed and maintained through collaborative, consensus-driven processes; and are freely available for use and adaptation without license restrictions."
        }
      ],
      "skos:scopeNote": "Transcribed from Figure 1 (p. 2). The figure's text is drawn as outlines, so the ingest could not extract it (vector-figures.json: vfig-p002 unrendered); the transcription was read off a 220 dpi render of the page on 2026-10-31 and needs a person to confirm it. Example given in the figure: the OpenHIE Architecture.",
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/full-stac/open-standards"
        },
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/full-stac/open-technologies"
        }
      ],
      "dcterms:source": "library/mehl-2023-full-stac-oqad018/sections/sec-000-a-full-stac-remedy-for-global-digital-health-tra.md#figure-1",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/full-stac/open-content",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/full-stac"
      },
      "skos:prefLabel": [
        {
          "@value": "Open Content"
        }
      ],
      "skos:definition": [
        {
          "@value": "Representations of public health, health system, or clinical knowledge, which are developed to meet the business needs described by an open architecture, and which describe, using open standards, assets such as minimum datasets, decision-support logic, care protocols, performance metrics, workflows, and reporting templates. Open content is developed, validated, and maintained through expert communities, and is freely available for use and adaptation without license restrictions."
        }
      ],
      "skos:scopeNote": "Transcribed from Figure 1 (p. 2). The figure's text is drawn as outlines, so the ingest could not extract it (vector-figures.json: vfig-p002 unrendered); the transcription was read off a 220 dpi render of the page on 2026-10-31 and needs a person to confirm it. Example given in the figure: a WHO SMART Guidelines FHIR Implementation Guide.",
      "dcterms:requires": [
