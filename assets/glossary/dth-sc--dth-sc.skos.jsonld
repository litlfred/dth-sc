      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/dth-sc/v0/ns#glossary/dth-sc/order-management-system",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sc/v0/ns#glossary/dth-sc"
      },
      "skos:prefLabel": [
        {
          "@value": "Order Management System"
        }
      ],
      "skos:definition": [
        {
          "@value": "A paper-based or software tool that supports the processes for fulfilling requisition orders (e.g., a software tool that supports entry and processing of requisition orders from health facilities to regional or central warehouses to replenish inventory)."
        }
      ],
      "skos:scopeNote": "Handbook definition, quoted. Open: not adopted, nothing chosen between alternatives.",
