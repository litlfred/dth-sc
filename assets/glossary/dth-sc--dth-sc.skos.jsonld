      "skos:prefLabel": [
        {
          "@value": "Digital Health Supply Chain"
        }
      ],
      "skos:altLabel": [
        "DHSC"
      ],
      "skos:definition": [
        {
          "@value": "The knowledge and practice of adopting digital technologies to improve health supply chains and enable the delivery of quality-assured health products to individuals when and where they need them."
        }
      ],
      "skos:scopeNote": "Handbook definition, quoted. Open: not adopted, nothing chosen between alternatives. Defined in the Introduction (PDF 12), not in the handbook's glossary.",
