    {
      "@id": "https://litlfred.github.io/dth-sc/v0/ns#glossary/dth-sc/health-supply-chain-information-system",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sc/v0/ns#glossary/dth-sc"
      },
      "skos:prefLabel": [
        {
          "@value": "Health Supply Chain Information System"
        }
      ],
      "skos:altLabel": [
        "HSCIS",
        "electronic logistics management information system"
      ],
      "skos:definition": [
        {
          "@value": "A paper-based or software tool that supports the management and/or operations of the health supply chain. Such software tools (e.g., for order management or warehouse management) are also commonly referred to as electronic logistics management information systems."
        }
      ],
      "skos:scopeNote": "Handbook definition, quoted. Open: not adopted, nothing chosen between alternatives. smart-ra models the individual systems as ArchiMate application components (sc-workplan.md section 4).",
      "skos:related": [
        {
