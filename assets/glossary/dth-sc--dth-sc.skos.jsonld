    {
      "@id": "https://litlfred.github.io/dth-sc/v0/ns#glossary/dth-sc/order-management",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sc/v0/ns#glossary/dth-sc"
      },
      "skos:prefLabel": [
        {
          "@value": "Order Management"
        }
      ],
      "skos:definition": [
        {
          "@value": "The planning, directing, monitoring and controlling of the processes related to customer or requisition orders. Order management includes order promising; order entry; order pick, pack and ship; billing; and reconciliation of the customer account."
        }
      ],
      "skos:scopeNote": "Handbook definition, quoted. Open: not adopted, nothing chosen between alternatives. The handbook cites its reference 11 for this definition.",
      "skos:broadMatch": [
        {
          "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra/capability"
        }
      ],
