    {
      "@id": "https://litlfred.github.io/dth-sc/v0/ns/glossary/dth-sc/governance-health-supply-chain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/dth-sc/v0/ns/glossary/dth-sc"
      },
      "skos:prefLabel": [
        {
          "@value": "Governance (Health Supply Chain)"
        }
      ],
      "skos:definition": [
        {
          "@value": "In the context of the health supply chain, the process of establishing and implementing policies, procedures and mechanisms to ensure that the supply chain processes and the systems to manage those processes are managed effectively, ethically and in alignment with established objectives and stakeholders' interests."
        }
      ],
      "skos:scopeNote": "Handbook definition, quoted. Open: not adopted, nothing chosen between alternatives. Boxed definition in Chapter 3 (PDF 45). Differs substantively from the draft RA's 'governance'; both are recorded as alternatives in litlfred/smart-ra#140.",
