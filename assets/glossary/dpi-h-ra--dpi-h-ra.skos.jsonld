      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Client"
        }
      ],
      "skos:definition": [
        {
          "@value": "Members of the public who are potential or current users of health services, including health prevention and wellness activities."
        }
      ],
      "skos:scopeNote": "The RA draft's own wording, verbatim. A candidate until the RA editors adopt it through the public review.",
