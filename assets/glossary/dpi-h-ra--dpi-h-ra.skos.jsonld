      "skos:prefLabel": [
        {
          "@value": "Business Domain"
        }
      ],
      "skos:definition": [
        {
          "@value": "A specific focus area or subsystem within a broader business system, characterized by its own essential attributes"
        }
      ],
      "skos:scopeNote": "The RA draft's own wording, verbatim. A candidate until the RA editors adopt it through the public review. The draft marks this entry [Under review].",
