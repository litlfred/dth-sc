        "@id": "https://litlfred.github.io/smart-ra/v0/ns#glossary/dpi-h-ra"
      },
      "skos:prefLabel": [
        {
          "@value": "Business Services layer"
        }
      ],
      "skos:definition": [
        {
          "@value": "A layer of the reference architecture grouping the health capabilities that national health systems strive to deliver across their principal domains — clinical care, public health, the health supply chain, and health financing — together with the shared components that enable them."
        }
      ],
      "skos:scopeNote": "The RA draft's own wording, verbatim. A candidate until the RA editors adopt it through the public review.",
      "dcterms:source": "folio/dpi-h-ra/glossary/t-glossary-lead-a31853.md",
      "skos:note": "candidate"
    },
    {
